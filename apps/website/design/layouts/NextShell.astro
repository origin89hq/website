---
import "../styles/next.css";
interface Props {
  title: string;
  theme?: string;
  direction?: string;
  review?: boolean;
}
const { title, theme = "paper", direction = "", review = false } = Astro.props;
const _nav = [
  ["The system", "system"],
  ["Equipment", "equipment"],
  ["Your site", "sites"],
  ["Open source", "open"],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content="Origin89 website exploration. Open control for remote and off-grid sites. Product and interface concepts in development." />
  <title>{title} · Origin89</title><link rel="icon" href={art.plate} type="image/svg+xml" />
  <style is:inline set:html={`@font-face{font-family:'Next Inter';src:url('${art.inter}') format('truetype');font-weight:100 900;font-display:swap}@font-face{font-family:'Next Mono';src:url('${art.mono}') format('truetype');font-weight:400;font-display:swap}`} />
</head>
<body class:list={['next',theme,{review}]}>
  <a class="skip-next" href="#content">Skip to content</a>
  <div class="draft-strip"><a href="/">Website study 02 <span> / Compare directions</span></a><span>{direction || 'Positioning & design'} · In development</span></div>
  <header class="next-header frame">
    <a class="next-logo" href={review?'/':'/next/equipment-first/'} aria-label="Origin89 home"><img src={theme==='dark'?art.logoWhite:art.logoBlue} alt="Origin89" width="185" height="39" /></a>
    <nav aria-label="Main navigation">{nav.map(([label,path])=><a href={`/next/${path}/`}>{label}</a>)}</nav>
    <a class="header-action" href="/next/plan/">Plan your setup <span aria-hidden="true">↗</span></a>
    <details class="next-menu"><summary>Menu +</summary><nav aria-label="Mobile navigation">{nav.map(([label,path])=><a href={`/next/${path}/`}>{label}</a>)}<a href="/next/plan/">Plan your setup ↗</a></nav></details>
  </header>
  <main id="content"><slot /></main>
  <footer class="next-footer"><div class="frame footer-grid">
    <div><img src={art.logoWhite} alt="Origin89" width="190" height="40" /><p>Open control for<br />remote and off-grid sites.</p><span class="micro">Designed in Québec · In development</span></div>
    <div><span class="micro">Products</span><a href="/next/controller/">Controller</a><a href="/next/offgrid/">Offgrid app</a><a href="/next/buddy/">Buddy</a><a href="/next/system/">How it fits together</a></div>
    <div><span class="micro">Explore</span><a href="/next/equipment/">Equipment catalogue</a><a href="/next/sample-site/">Sample site</a><a href="/next/open/">The open stack</a><a href="/next/sites/">Sites & applications</a></div>
    <div><span class="micro">Start here</span><a href="/next/plan/">Plan your setup</a><a href="https://docs.origin89.com/">Documentation ↗</a><a href="/next/research/">Design rationale</a><a href="/round-1/">First design round</a></div>
  </div><div class="frame footer-baseline"><span>© 2026 Origin89</span><span>Website prototype · Illustrative product experiences</span><a href="/">Compare the three directions ↗</a></div></footer>
</body>
</html>
