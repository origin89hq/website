---
// The real `decide` out of crates/o89-core/src/generator/machine.rs, not a
// plausible-looking invention. The act claims you can read the line that starts
// a generator, and printing a fake one next to that sentence would be the page
// telling the exact lie the section is about.
//
// It is transcribed rather than imported: the website does not build the crate,
// and an `include_str!` equivalent here would mean parsing Rust at build time to
// find the function. The cost of that choice is that the snippet can drift from
// the source, so it is short enough to check by eye against the file named in
// the window chrome. That drift HAPPENED: an earlier transcription dropped the
// concern reset, the proof line and the phase step, and the gutted function
// read like a toy. Check against machine.rs before touching these lines.
//
// The highlighter is a build-time pass over an authored constant, which is the
// only reason a regex over source text is acceptable here: the input is these
// ten lines and nothing else, and the alternative is a hundred hand-typed token
// objects that go stale the first time a line changes.
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;

const _SOURCE = "o89-core/src/generator/machine.rs";

const CODE = [
  "pub fn decide(&mut self, now: Tick, inputs: Inputs) -> Decision {",
  "    self.concern = None;",
  "    let level = inputs.level(self.settings.autostart);",
  "    let proof = inputs.proof(self.settings.ac_live);",
  "    self.last = match self.permitted(now, inputs) {",
  "        Permitted::No(why) => self.stand_down(why),",
  "        Permitted::Waiting => self.last,",
  "        Permitted::Yes => {",
  "            self.follow_the_bank(now, level);",
  "            self.phase = self.next(now, proof);",
  "            self.decision_for()",
  "        }",
  "    };",
  "    self.last",
  "}",
];

/** Every file the crate is made of, which is the point of "all of it". */
const _FILES = [
  "decision.rs",
  "frost.rs",
  "generator/",
  "journal.rs",
  "log.rs",
  "outbound.rs",
  "output.rs",
  "render.rs",
  "ring.rs",
  "store.rs",
  "time.rs",
];

const KEYWORDS = new Set(["pub", "fn", "match", "return", "let"]);

type Kind = "kw" | "type" | "call" | "plain";

const _TONE: Record<Kind, string> = {
  kw: "text-warning",
  type: "text-info",
  call: "text-fg",
  plain: "text-muted",
};

const classify = (word: string, after: string): Kind => {
  if (KEYWORDS.has(word)) return "kw";
  if (/^[A-Z]/.test(word)) return "type";
  if (after.startsWith("(")) return "call";
  return "plain";
};

/** Split into identifier / not-identifier runs, so punctuation keeps its place
 *  and the line still round-trips to exactly the source text. */
const tokenise = (line: string) =>
  [...line.matchAll(/([A-Za-z_][A-Za-z0-9_]*)|([^A-Za-z_]+)/g)].map((match) => {
    const word = match[1];
    if (word === undefined) return { text: match[0], kind: "plain" as Kind };
    return { text: word, kind: classify(word, line.slice(match.index + word.length)) };
  });

const _LINES = CODE.map(tokenise);
---

<div class="flex w-full max-w-112 flex-col items-center gap-5">
  <!-- Hidden from screen readers: it is a picture of code the paragraph beside
       it already describes, and reading ten lines of Rust aloud helps nobody. -->
  <div
    class="w-full overflow-hidden rounded-xl border border-line-strong bg-surface"
    aria-hidden="true"
  >
    <div class="flex items-center gap-2.5 border-b border-line px-4 py-2.5">
      <span class="h-2 w-2 rounded-full bg-line-strong"></span>
      <span class="font-mono text-[0.6rem] tracking-wide text-faint">{SOURCE}</span>
    </div>

<!-- Sized so the longest line fits rather than scrolls: clipping half an
         identifier on a section about being able to read the code is the
         worst possible place to hide a line. Longest line today is 65
         characters (the signature); re-measure if `decide` changes shape. -->
    <pre class="overflow-x-auto px-3.5 py-4 font-mono text-[0.56rem] leading-[1.7]"><code>{
      LINES.map((line, i) => (
        <span data-open-line class="block">{
          line.map((token) => <span class={TONE[token.kind]}>{token.text}</span>)
        }{i === LINES.length - 1 && (
          <span data-open-caret class="ml-px inline-block w-[0.5em] bg-warning align-middle">&nbsp;</span>
        )}</span>
      ))
    }</code></pre>
  </div>

  <div class="flex flex-col items-center gap-2.5">
    <p class="eyebrow">{copy.actLabels.source}</p>
    <ul class="flex flex-wrap justify-center gap-x-3 gap-y-1.5">
      {
        FILES.map((file) => (
          <li data-open-file class="font-mono text-[0.62rem] text-faint">
            {file}
          </li>
        ))
      }
    </ul>
  </div>
</div>
