---
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const { faq } = copy;
---

<section id="faq" class="faq-continuity relative overflow-hidden">
  <div class="relative mx-auto max-w-6xl px-6 py-28 lg:py-40">
    <div class="grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="eyebrow">{faq.kicker}</p>
        <h2
          class="headline mt-4 text-[clamp(1.8rem,3.6vw,2.7rem)] leading-[1.08] text-balance"
        >
          {faq.title}
        </h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-muted text-pretty">{faq.lede}</p>
      </div>

      <div class="border-t border-line-strong">
        {
          faq.items.map((item, index) => (
            <details class="group border-b border-line-strong" open={index === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left text-lg font-medium tracking-[-0.01em] text-fg transition-colors marker:content-none hover:text-action-lit [&::-webkit-details-marker]:hidden">
                <span>{item.question}</span>
                <span
                  class="relative h-5 w-5 shrink-0 text-faint transition-colors group-open:text-action-lit"
                  aria-hidden="true"
                >
                  <span class="absolute top-1/2 left-0 h-px w-5 -translate-y-1/2 bg-current" />
                  <span class="absolute top-0 left-1/2 h-5 w-px -translate-x-1/2 bg-current transition-transform duration-200 group-open:rotate-90" />
                </span>
              </summary>
              <p class="max-w-2xl pb-7 pr-10 leading-relaxed text-muted text-pretty">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq-continuity {
    background: transparent;
  }

</style>
