{
  "name": "origin89-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm prepare:website && vite",
    "design:dev": "pnpm dev",
    "design:check": "pnpm check",
    "design:build": "pnpm build && node scripts/refresh-preview.mjs",
    "build": "pnpm build:site && pnpm storybook:build && node scripts/mount-storybook.mjs",
    "check": "pnpm prepare:website && tsc --project tsconfig.react.json",
    "preview": "wrangler dev -c wrangler.jsonc -c node_modules/@origin89/buddy/fixture/wrangler.jsonc --env fixture",
    "deploy:cf": "pnpm deploy:config && wrangler deploy --config wrangler.deploy.json --experimental-provision=false",
    "astro": "astro",
    "storybook": "pnpm design:assets && storybook dev --port 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "storybook:build": "pnpm design:assets && storybook build --output-dir storybook-static --disable-telemetry",
    "design:assets": "pnpm prepare:website",
    "design:react": "pnpm dev",
    "design:review": "pnpm design:build",
    "build:site": "pnpm prepare:website && node scripts/build-website.mjs",
    "prepare:website": "node scripts/prepare-website.mjs",
    "archive:build": "astro build --config astro.design.config.mjs",
    "archive:dev": "ASTRO_DEV_BACKGROUND=1 astro dev --config astro.design.config.mjs --ignore-lock",
    "verify:website": "node scripts/verify-website.mjs",
    "verify:storybook": "node .storybook/verify.mjs",
    "verify:buddy-assets": "node scripts/verify-buddy-assets.mjs",
    "preview:fixture": "wrangler dev -c wrangler.jsonc -c node_modules/@origin89/buddy/fixture/wrangler.jsonc --env fixture",
    "test": "node --test test/*.test.mjs",
    "deploy:config": "node --env-file-if-exists=.env.production scripts/deployment-config.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.96",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@origin89/brand": "0.2.0",
    "@origin89/buddy": "https://github.com/origin89hq/buddy/releases/download/v0.1.0/origin89-buddy-0.1.0.tgz",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.33",
    "ai": "^7.0.93",
    "astro": "^7.1.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "gsap": "^3.15.0",
    "lucide-react": "^1.42.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "use-stick-to-bottom": "^1.1.6",
    "@origin89/ui-react": "https://github.com/origin89hq/ui/releases/download/v0.1.0/origin89-ui-react-0.1.0.tgz"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "sharp": "0.35.3",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "wrangler": "4.129.1",
    "jsonc-parser": "3.3.1"
  },
  "license": "UNLICENSED"
}
