---
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const { status, contact } = copy;
---

<section id="status" class="status-continuity relative overflow-hidden">
  <div class="relative mx-auto max-w-6xl px-6 pt-14 pb-28 lg:pt-20 lg:pb-40">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div class="text-center lg:text-left">
        <p class="eyebrow">{status.kicker}</p>
        <h2
          class="headline mt-4 text-[clamp(1.8rem,3.6vw,2.7rem)] leading-[1.08] text-balance"
        >
          {status.title}
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-muted text-pretty">{status.body}</p>
      </div>

      <div
        id="setup"
        class="self-start rounded-2xl border border-line-strong bg-linear-to-b from-surface-raised to-surface p-8 text-center lg:p-10 lg:text-left"
      >
        <h2 class="text-2xl leading-tight font-medium tracking-[-0.02em] text-balance">
          {contact.title}
        </h2>
        <p class="mt-4 leading-relaxed text-muted text-pretty">{contact.body}</p>
        <a
          href={`mailto:${SITE.email}`}
          class="plate mt-7 inline-block rounded-xl px-5 py-3 font-medium text-on-fill"
        >
          <span class="relative z-10">{contact.cta}</span>
        </a>
        <p class="mt-3 font-mono text-xs text-faint">{SITE.email}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .status-continuity {
    background: transparent;
  }

</style>
