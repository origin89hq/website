{
  "name": "origin89-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm prepare:website && vite",
    "build": "pnpm build:site && pnpm storybook:build && node scripts/mount-storybook.mjs",
    "check": "pnpm prepare:website && tsc --project tsconfig.json && pnpm check:worker",
    "preview": "wrangler dev -c wrangler.jsonc -c node_modules/@origin89/buddy/fixture/wrangler.jsonc --env fixture",
    "deploy:cf": "pnpm deploy:config && wrangler deploy --config wrangler.deploy.json --experimental-provision=false",
    "storybook": "pnpm prepare:website && storybook dev --port 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "storybook:build": "pnpm prepare:website && storybook build --output-dir storybook-static --disable-telemetry",
    "build:site": "pnpm prepare:website && node scripts/build-website.mjs",
    "prepare:website": "node scripts/prepare-website.mjs",
    "verify:website": "node scripts/verify-website.mjs",
    "verify:storybook": "node .storybook/verify.mjs",
    "verify:buddy-assets": "node scripts/verify-buddy-assets.mjs",
    "test": "node --test test/*.test.mjs",
    "deploy:config": "node --env-file-if-exists=.env.production scripts/deployment-config.mjs",
    "check:worker": "wrangler types && tsc --project tsconfig.worker.json"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.96",
    "@origin89/brand": "0.4.0",
    "@origin89/buddy": "0.1.1",
    "@origin89/ui-react": "0.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.33",
    "ai": "^7.0.93",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "three": "0.186.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsonc-parser": "3.3.1",
    "playwright": "1.63.0",
    "sharp": "0.35.3",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "wrangler": "4.129.1"
  },
  "license": "UNLICENSED"
}
