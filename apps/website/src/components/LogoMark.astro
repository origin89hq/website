---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class:list={['origin-mark inline-flex shrink-0', className]}
  aria-hidden="true"
  set:html={mark}
/>

<style>
  .origin-mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
