---

<Base copy={COPY} noindex>
  <section class="mx-auto max-w-3xl px-6 py-28 lg:py-40">
    <p class="eyebrow">404</p>

    <h1 class="mt-5 text-[clamp(2rem,5vw,3rem)] leading-tight font-semibold tracking-[-0.03em]">
      {COPY.notFound.title}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-muted text-pretty">{COPY.notFound.body}</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg border border-on-fill/85 bg-action px-5 py-3 font-medium text-on-fill transition-colors hover:bg-action-lit"
    >
      {COPY.notFound.cta}
    </a>
  </section>
</Base>
