---
import type { Copy, SafetyLoadState } from "../i18n/copy";

interface Props {
  copy: Copy;
  active?: boolean;
}
const { copy, active = false } = Astro.props;
const { phone } = copy;

const _STATE_STYLE: Record<SafetyLoadState, { dot: string; text: string }> = {
  protected: { dot: "bg-nominal", text: "text-nominal" },
  paused: { dot: "bg-white/25", text: "text-white/45" },
};
---

<div class:list={['o89-view px-4', active && 'is-on']} data-screen="safety">
  <p class="px-1 pt-5 font-mono text-[0.58rem] tracking-widest uppercase text-white/40">
    {phone.safety.label}
  </p>
  <p class="mt-0.5 px-1 text-[1.25rem] leading-none font-medium tracking-tight text-white">
    {phone.siteName}
  </p>

  <div
    class="mt-4 rounded-[1.3rem] border border-nominal/55 bg-[linear-gradient(135deg,rgba(47,157,100,0.24),rgba(47,157,100,0.08))] px-4 py-3.5 shadow-[inset_0_1px_0_rgba(255,255,255,0.06),0_0_24px_rgba(47,157,100,0.12)]"
  >
    <div class="flex items-center gap-2">
      <span
        class="h-2 w-2 shrink-0 rounded-full bg-nominal shadow-[0_0_0_4px_rgba(47,157,100,0.14),0_0_14px_rgba(47,157,100,0.7)]"
        aria-hidden="true"
      ></span>
      <p class="font-mono text-[0.58rem] font-medium tracking-widest uppercase text-nominal">
        {phone.safety.status}
      </p>
    </div>
    <p class="mt-2 text-[0.68rem] leading-snug text-white/65">{phone.safety.summary}</p>
  </div>

  <p class="mt-3.5 px-1 font-mono text-[0.52rem] tracking-widest uppercase text-white/35">
    {phone.safety.reasonsLabel}
  </p>
  <ul class="mt-1.5 flex flex-wrap gap-1.5">
    {
      phone.safety.reasons.map((reason) => (
        <li class="rounded-full border border-white/10 bg-white/[0.06] px-2.5 py-1 font-mono text-[0.5rem] leading-tight text-white/55">
          {reason}
        </li>
      ))
    }
  </ul>

  <p class="mt-3.5 px-1 font-mono text-[0.52rem] tracking-widest uppercase text-white/35">
    {phone.safety.loadsLabel}
  </p>
  <ul class="mt-1.5 overflow-hidden rounded-[1.1rem] border border-white/10 bg-white/[0.06]">
    {
      phone.safety.loads.map((load) => (
        <li class="flex items-center justify-between gap-3 border-b border-white/8 px-3.5 py-2.5 last:border-b-0">
          <span class="flex min-w-0 items-center gap-2 text-[0.68rem] text-white/65">
            <span class:list={['h-1.5 w-1.5 shrink-0 rounded-full', STATE_STYLE[load.state].dot]}></span>
            {load.label}
          </span>
          <span class:list={['shrink-0 font-mono text-[0.68rem]', STATE_STYLE[load.state].text]}>
            {load.value}
          </span>
        </li>
      ))
    }
  </ul>

  <div class="mt-3 rounded-[1.1rem] border border-info/20 bg-info/[0.06] px-3.5 py-3">
    <div class="flex items-baseline justify-between gap-3">
      <span class="text-[0.68rem] text-white/60">{phone.safety.syncLabel}</span>
      <span class="font-mono text-[0.68rem] text-info">{phone.safety.syncWindow}</span>
    </div>
    <p class="mt-1.5 font-mono text-[0.52rem] leading-tight text-info/65">
      {phone.safety.urgentWake}
    </p>
  </div>
</div>
