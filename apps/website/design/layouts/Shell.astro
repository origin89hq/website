---
import { type Direction, href } from "../lib/content";
import "../styles/design.css";
interface Props {
  title: string;
  direction?: Direction;
  page?: string;
}
const { title, direction = "field-guide", page = "" } = Astro.props;
const _comparison = Astro.url.pathname === "/" || Astro.url.pathname === "/round-1/";
const _url = (path = "") => href(direction, path);
const _nav = [
  ["Products", "products"],
  ["Your site", "solutions"],
  ["Compatibility", "compatibility"],
  ["Developers", "developers"],
  ["Our story", "about"],
];
---
<!doctype html>
<html lang="en" data-direction={direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="A first design study for the complete Origin89 website, based on the Plate 89 identity." />
    <title>{title} · Origin89 design study</title>
    <link rel="icon" href={art.plate} type="image/svg+xml" />
    <style is:inline set:html={`@font-face{font-family:'Draft Inter';src:url('${art.inter}') format('truetype');font-style:normal;font-weight:100 900;font-display:swap}@font-face{font-family:'Draft Mono';src:url('${art.mono}') format('truetype');font-style:normal;font-weight:400;font-display:swap}`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="review-bar">
      <a href="/">O89 / Website study 01</a>
      <span class="review-note">Design draft · 07 Sep 2026</span>
      <nav aria-label="Design direction">
        <a href={href('field-guide', page)} aria-current={!comparison && direction === 'field-guide' ? 'page' : undefined}>A <span>Field guide</span></a>
        <a href={href('instrument', page)} aria-current={!comparison && direction === 'instrument' ? 'page' : undefined}>B <span>Instrument</span></a>
        <a href="/" aria-current={comparison ? 'page' : undefined}>Compare</a>
      </nav>
    </div>
    {!comparison && <header class="header wrap">
      <a href={url()} aria-label="Origin89 home" class="brand"><img src={direction === 'instrument' ? art.logoWhite : art.logoBlue} width="194" height="40" alt="Origin89" /></a>
      <nav class="desktop-nav" aria-label="Main navigation">{nav.map(([label, path]) => <a href={url(path)} aria-current={page.startsWith(path) ? 'page' : undefined}>{label}</a>)}</nav>
      <a href={url('contact')} class="button small header-cta">Let’s talk <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation">{nav.map(([label, path]) => <a href={url(path)}>{label}</a>)}<a href={url('contact')}>Let’s talk ↗</a></nav></details>
    </header>}
    <main id="main"><slot /></main>
    {!comparison && <footer class="footer">
      <div class="wrap footer-top"><div><img src={art.logoWhite} width="200" height="42" alt="Origin89" /><p>Simple control. Your way.<br />Built in Québec, for your corner of the world.</p></div>
        <div><span class="eyebrow">Product family</span><a href={url('products/controller')}>Controller</a><a href={url('products/offgrid')}>Offgrid</a><a href={url('products/buddy')}>Buddy</a><a href={url('products')}>How they fit together</a></div>
        <div><span class="eyebrow">Your site</span><a href={url('solutions/cottages')}>Cottages & off-grid</a><a href={url('solutions/maple')}>Maple operations</a><a href={url('solutions/field')}>Field & industrial</a><a href={url('compatibility')}>Equipment compatibility</a></div>
        <div><span class="eyebrow">Origin89</span><a href={url('about')}>Our story</a><a href={url('developers')}>Developers</a><a href={SITE.docsUrl}>Documentation ↗</a><a href={url('contact')}>Get in touch</a></div>
      </div>
      <div class="wrap footer-bottom"><span>© 2026 Origin89</span><span>In development. Let’s build around your site.</span><a href="/">Back to the design comparison ↗</a></div>
    </footer>}
  </body>
</html>
