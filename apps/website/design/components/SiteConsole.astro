---
interface Props {
  interactive?: boolean;
}
const { interactive = false } = Astro.props;
---
<div class="site-console" data-console>
  <div class="console-top"><span><span class="status-dot"></span> NORTH COTTAGE</span><span>Illustrative interface · Sample data</span></div>
  <div class="console-heading"><div><span class="micro">Your site / Overview</span><h2>Ready for the weekend?</h2></div><span class="connection-label" role="status" data-connection>Connected · Updated just now</span></div>
  <div class="console-notice" data-connection-note hidden>Connection lost. These are the last received readings, from 12 minutes ago. This view cannot confirm the site’s current condition.</div>
  <div class="console-readings">
    <div class="reserve-reading"><span class="micro">Battery reserve</span><div class="big-reading">78<span>%</span></div><div class="reserve-meter" aria-hidden="true"><i></i></div><span data-reading-time>Last received just now</span></div>
    <div class="solar-reading"><span class="micro">Solar generation</span><div class="medium-reading">2.4 <span>kW</span></div><svg viewBox="0 0 300 85" role="img" aria-label="Illustrative solar generation curve"><path d="M0 80L25 79L45 76L65 63L85 69L105 30L125 45L145 25L165 36L185 13L205 22L225 12L245 32L270 22L300 26" fill="none" stroke="currentColor" stroke-width="2"/><path d="M0 84H300" stroke="currentColor" opacity=".2"/></svg><span data-reading-time>Last received just now</span></div>
    <div><span class="micro">Inside temperature</span><div class="medium-reading">18.4<span>°C</span></div><p>Cottage / Main room</p><span data-reading-time>Last received just now</span></div>
  </div>
  <div class="console-bottom"><div><span class="micro">Backup generator</span><strong>Stopped <span class="muted" data-generator-note>· Last received just now</span></strong></div><div><span class="micro">Recent activity</span><strong>Solar charging resumed <span class="muted">· Recorded at 09:12</span></strong></div><span class="micro">READINGS ONLY</span></div>
  {interactive&&<div class="console-controls"><span>Explore a sample connection change</span><button type="button" aria-pressed="false" data-toggle-connection>Simulate connection loss</button></div>}
</div>
{interactive&&<script>
  document.querySelectorAll<HTMLElement>('[data-console]').forEach(consolePanel=>{
    const button=consolePanel.querySelector<HTMLButtonElement>('[data-toggle-connection]');
    button?.addEventListener('click',()=>{
      const stale=button.getAttribute('aria-pressed')!=='true';
      button.setAttribute('aria-pressed',String(stale));
      button.textContent=stale?'Restore sample connection':'Simulate connection loss';
      consolePanel.classList.toggle('is-stale',stale);
      const label=consolePanel.querySelector('[data-connection]');
      if(label)label.textContent=stale?'Connection lost · Last received 12 min ago':'Connected · Updated just now';
      const note=consolePanel.querySelector<HTMLElement>('[data-connection-note]');
      if(note){note.hidden=!stale;}
      consolePanel.querySelectorAll('[data-reading-time]').forEach(el=>el.textContent=stale?'Last received 12 minutes ago':'Last received just now');
      const generator=consolePanel.querySelector('[data-generator-note]');
      if(generator)generator.textContent=stale?'· Last received 12 min ago':'· Last received just now';
    });
  });
</script>}
