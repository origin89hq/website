---
// Four claims, one per screen. On a full desktop one shared canvas stays pinned
// while only the copy and drawing change, so no full-height panel edge crosses
// the composition. The hero's walkthrough answers "what does it do";
// this answers "why is it built like that", and the two must not trade jobs — a
// claim here that needs a phone screen to make sense belongs in the hero instead.
//
// The choreography for all four drawings lives in this file rather than in the
// four components. It is the file that owns the pinning, and a timeline scrubbed
// by a ScrollTrigger created somewhere else is a race nobody can read.
import type { ActKey, Copy } from "../i18n/copy";
import ActAlone from "./ActAlone.astro";
import ActGear from "./ActGear.astro";
import ActHealth from "./ActHealth.astro";
import ActOpen from "./ActOpen.astro";

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;

/** Keyed by `ActKey`, so adding an act to the copy without drawing anything for
 *  it fails the type check instead of rendering a column of empty space. */
const _VISUAL: Record<ActKey, typeof ActAlone> = {
  alone: ActAlone,
  gear: ActGear,
  health: ActHealth,
  open: ActOpen,
};
---

<section data-acts style={`--acts-runway: ${(copy.acts.length + 1) * 100}svh`}>
  <!-- Runs during parse, before anything paints. The scroll choreography needs
       both desktop width and enough height for the complete drawing below the
       fixed header. On a phone or a short laptop window every claim renders in
       its finished state and scrolls naturally, so a pin can never trap or clip
       content that physically does not fit. -->
  <script is:inline>
    const actMotion = window.matchMedia('(min-width: 1024px) and (min-height: 800px)');
    const actStill = window.matchMedia('(prefers-reduced-motion: reduce)');
    const syncActMotion = () =>
      document.documentElement.toggleAttribute('data-motion', actMotion.matches && !actStill.matches);

    syncActMotion();
    actMotion.addEventListener('change', syncActMotion);
    actStill.addEventListener('change', syncActMotion);
  </script>

  <div data-acts-stage>
    {
      copy.acts.map((act) => {
        const Visual = VISUAL[act.key];
        return (
          <article id={`act-${act.key}`} class="relative" data-act={act.key}>
            <div
              data-act-pin
              class="relative flex min-h-svh items-center overflow-hidden"
            >
            <!-- The drawing column is a fixed width, not `auto`. Sized by its
                 content it collapsed to about a third: the SVGs are `w-full`,
                 and a shrink-to-fit column asking the SVG how wide it wants to
                 be while the SVG asks the column back resolves tiny. -->
            <div data-act-layout class="mx-auto grid w-full min-w-0 max-w-6xl items-center gap-14 px-6 py-24 lg:grid-cols-[1fr_26rem] lg:gap-20 lg:py-16">
              <div class="min-w-0 text-center lg:text-left" data-act-copy>
                <h2
                  class="headline text-[clamp(3.2rem,11vw,6rem)] leading-[0.92] lg:text-[clamp(4.5rem,6.8vw,7.25rem)]"
                >
                  <span class="block overflow-hidden pb-[0.08em]">
                    <span data-act-word class="block">{act.word}</span>
                  </span>
                </h2>

                <p
                  data-act-body
                  class:list={[
                    'mx-auto mt-8 max-w-xl text-[clamp(1.05rem,1.6vw,1.2rem)] leading-[1.65] text-muted text-pretty lg:mx-0 2xl:text-[1.25rem]',
                    act.key === 'alone' && 'lg:max-w-2xl',
                  ]}
                >
                  <BrandText text={act.body} />
                </p>
              </div>

              <div
                class:list={[
                  'flex min-w-0 justify-center',
                  act.key === 'alone' && 'lg:scale-[1.08] 2xl:scale-[1.14]',
                ]}
                data-mobile-visual
                data-act-visual={act.key}
              >
                <Visual copy={copy} />
              </div>
            </div>
            </div>
          </article>
        );
      })
    }

    <div
      class="acts-next pointer-events-none absolute bottom-7 left-1/2 z-20 hidden -translate-x-1/2 flex-col items-center gap-2 text-faint"
      aria-hidden="true"
      data-acts-next
    >
      <span class="font-mono text-[0.62rem] tracking-[0.18em] uppercase">Scroll</span>
      <svg
        viewBox="0 0 64 38"
        class="h-auto w-7"
        fill="none"
        aria-hidden="true"
      >
        <path d="m8 7 24 24L56 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  [data-acts] {
    background: transparent;
  }

  [data-act-pin] {
    background: transparent;
  }

  @media (min-width: 1024px) and (min-height: 800px) {
    :global([data-motion]) [data-acts] {
      position: relative;
      height: var(--acts-runway);
    }

    :global([data-motion]) [data-acts-stage] {
      position: sticky;
      top: 0;
      height: 100svh;
      overflow: hidden;
      background: var(--color-content-sky);
    }

    :global([data-motion]) [data-act] {
      position: absolute;
      inset: 0;
      min-height: 0;
      visibility: hidden;
    }

    :global([data-motion]) [data-act-pin] {
      position: absolute;
      inset: 0;
      height: 100%;
      min-height: 0;
      background: transparent;
    }

    :global([data-motion]) [data-acts-next] {
      display: flex;
    }
  }

  /* The compatibility drawing is the tallest act. Below this height it cannot
     fit between the fixed header and the viewport edge, even though the width
     is technically "desktop". Let the panel grow with its content and reduce
     only the vertical breathing room; the page then scrolls like an ordinary
     document instead of clipping the count inside a pinned viewport. */
  @media (min-width: 1024px) and (max-height: 799px) {
    [data-act-pin] {
      min-height: auto;
      overflow: visible;
    }

    [data-act-layout] {
      padding-block: 2.5rem;
    }

    [data-act-visual='gear'] {
      width: 100%;
      max-width: 22rem;
      margin-inline: auto;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import type { ActKey } from '../i18n/copy';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('[data-acts]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // MatchMedia owns only the scroll reveals and pins. If a laptop window is
  // resized below the height threshold, GSAP reverts those inline styles and
  // the same markup becomes the compact, natural-scrolling fallback. Ambient
  // lamps, pulses and the code caret remain alive unless reduced motion is set.
  if (section && !still) {
    const acts = [...section.querySelectorAll<HTMLElement>('[data-act]')];
    const motionQuery = window.matchMedia('(min-width: 1024px) and (min-height: 800px)');

    /** Counts up to whatever the server rendered, preserving its grouping,
     *  decimal separator and unit instead of duplicating them in the animation. */
    const countUp = (el: Element | undefined, tl: gsap.core.Timeline, at: string | number) => {
      const raw = el?.textContent?.trim();
      const found = raw?.match(/[\d.,]+/)?.[0];
      if (!el || !raw || !found) return;

      const grouped = /^\d{1,3}(,\d{3})+$/.test(found);
      const separator = found.includes(',') ? ',' : '.';
      const places = grouped ? 0 : (found.split(/[.,]/)[1]?.length ?? 0);
      const target = Number(grouped ? found.replaceAll(',', '') : found.replace(',', '.'));
      const shown = (v: number) =>
        raw.replace(
          found,
          grouped
            ? Math.round(v).toLocaleString('en-CA')
            : v.toFixed(places).replace('.', separator),
        );

      const counter = { v: 0 };
      el.textContent = shown(0);
      tl.to(
        counter,
        {
          v: target,
          duration: 1,
          ease: 'none',
          onUpdate: () => {
            el.textContent = shown(counter.v);
          },
        },
        at,
      );
    };

    // The link goes, the log keeps writing, the link comes back and the phone
    // catches up. The entries land one at a time on purpose: a stagger tight
    // enough to arrive together would read as one event rather than as a
    // morning. The notifications on the phone are last, and they are the point —
    // nothing was waiting on that link, it just found out afterwards.
    const alone = (act: HTMLElement) => {
      const q = gsap.utils.selector(act);
      return gsap
        .timeline()
        .to(q('[data-alone-phone]'), { opacity: 1, duration: 0.45 })
        .fromTo(
          q('[data-alone-link]'),
          { scaleY: 0, svgOrigin: '210 72' },
          { scaleY: 1, opacity: 1, duration: 0.5, ease: 'power2.out' },
          '-=0.2',
        )
        .to(q('[data-alone-link]'), { opacity: 0.14, duration: 0.35 }, '+=0.3')
        .to(q('[data-alone-screen]'), { opacity: 0.14, duration: 0.35 }, '<')
        .to(q('[data-alone-cut]'), { opacity: 1, duration: 0.3 }, '<0.1')
        .fromTo(
          q('[data-alone-entry]'),
          { x: -8 },
          { x: 0, opacity: 1, duration: 0.35, stagger: 0.3, ease: 'power2.out' },
          '+=0.2',
        )
        .to(q('[data-alone-cut]'), { opacity: 0, duration: 0.3 }, '+=0.4')
        .to(q('[data-alone-link]'), { opacity: 1, duration: 0.35 }, '<')
        .to(q('[data-alone-screen]'), { opacity: 1, duration: 0.35 }, '<')
        .fromTo(
          q('[data-alone-note]'),
          { y: -4 },
          { y: 0, opacity: 1, duration: 0.3, stagger: 0.12, ease: 'power2.out' },
          '<0.25',
        );
    };

    const gear = (act: HTMLElement) => {
      const q = gsap.utils.selector(act);
      const tl = gsap
        .timeline()
        .to(q("[data-gear-diagram='full'] [data-gear-wire]"), {
          opacity: 1,
          duration: 0.4,
          stagger: 0.04,
        })
        .fromTo(
          q("[data-gear-diagram='full'] [data-gear-chip]"),
          { y: 10 },
          { y: 0, opacity: 1, duration: 0.5, stagger: 0.08, ease: 'power2.out' },
          '-=0.35',
        );
      countUp(q('[data-gear-count]')[0], tl, '-=0.5');
      return tl;
    };

    // Totals answer the daily question first; the curves then reveal where that
    // balance came from. Drawing the three traces together keeps consumption in
    // direct comparison with solar and the short generator run.
    const health = (act: HTMLElement) => {
      const q = gsap.utils.selector(act);
      const tl = gsap
        .timeline()
        .fromTo(
          q('[data-health-panel]'),
          { y: 10 },
          { y: 0, opacity: 1, duration: 0.45, ease: 'power2.out' },
        )
        .fromTo(
          q('[data-health-stats]'),
          { y: 8 },
          { y: 0, opacity: 1, duration: 0.38, ease: 'power2.out' },
          '-=0.15',
        )
        .fromTo(
          q('[data-health-count]'),
          { y: 5, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.32, stagger: 0.05, ease: 'power2.out' },
          0.18,
        )
        .fromTo(
          q('[data-health-clip]'),
          { attr: { width: 0 } },
          { attr: { width: 400 }, duration: 1.05, ease: 'power2.inOut' },
          '-=0.05',
        )
        .fromTo(
          q('[data-health-line]'),
          { strokeDashoffset: 1 },
          { strokeDashoffset: 0, duration: 1.05, ease: 'power2.inOut' },
          '<',
        )
        .fromTo(
          q('[data-health-point]'),
          { scale: 0, opacity: 0 },
          {
            scale: 1,
            opacity: 1,
            transformOrigin: 'center',
            duration: 0.28,
            stagger: 0.08,
            ease: 'back.out(2)',
          },
          '-=0.2',
        )
        .fromTo(
          q('[data-health-legend]'),
          { y: 4 },
          { y: 0, opacity: 1, duration: 0.28, stagger: 0.06, ease: 'power2.out' },
          '-=0.25',
        );

      return tl;
    };

    const open = (act: HTMLElement) => {
      const q = gsap.utils.selector(act);
      return gsap
        .timeline()
        .fromTo(
          q('[data-open-line]'),
          { x: -6 },
          { x: 0, opacity: 1, duration: 0.3, stagger: 0.15, ease: 'power2.out' },
        )
        .fromTo(
          q('[data-open-file]'),
          { y: 8 },
          { y: 0, opacity: 1, duration: 0.35, stagger: 0.05, ease: 'power2.out' },
          '+=0.25',
        );
    };

    // Loops, not scrub. Everything above answers to the scroll position, so a
    // reader who stops sees a still frame — and a still frame of a controller
    // with a dead lamp says the opposite of what these four screens claim.
    const loops = (act: HTMLElement) => {
      const q = gsap.utils.selector(act);

      // `svgOrigin`, not `transformOrigin`: GSAP replaces a CSS transform-origin
      // on an SVG element with 0 0 and folds the difference into a translate, so
      // a lamp asked to breathe about its own centre slides across the drawing
      // instead.
      //
      // Each lamp carries its own origin in the attribute value. Holding those
      // coordinates here meant the gear lamp drifted off its box the first time
      // a brand was added and the layout recentred.
      const breathe = (attribute: string) => {
        for (const lamp of q(`[${attribute}]`)) {
          gsap.to(lamp, {
            opacity: 0.42,
            scale: 1.16,
            svgOrigin: lamp.getAttribute(attribute) ?? '0 0',
            duration: 2.2,
            repeat: -1,
            yoyo: true,
            ease: 'sine.inOut',
          });
        }
      };

      breathe('data-alone-lamp');
      breathe('data-gear-lamp');

      // Animate both diagrams. CSS chooses the full or compact drawing for the
      // current viewport; keeping each one's stagger local means the compact
      // dots do not wait for all the hidden full-size dots to finish first.
      for (const diagram of q('[data-gear-diagram]')) {
        diagram.querySelectorAll('[data-gear-pulse]').forEach((pulse, i) => {
          const dx = Number(pulse.getAttribute('data-dx'));
          const dy = Number(pulse.getAttribute('data-dy'));
          gsap
            .timeline({ repeat: -1, delay: i * 0.32, repeatDelay: 0.8 })
            .to(pulse, { opacity: 1, duration: 0.25 })
            .to(pulse, { x: dx, y: dy, duration: 1.35, ease: 'none' }, 0)
            .to(pulse, { opacity: 0, duration: 0.3 }, 1.05)
            .set(pulse, { x: 0, y: 0 });
        });
      }

      const carets = q('[data-open-caret]');
      if (carets.length > 0) {
        gsap.to(carets, {
          opacity: 1,
          duration: 0.5,
          repeat: -1,
          yoyo: true,
          ease: 'steps(1)',
        });
      }
    };

    const loopedActs = new WeakSet<HTMLElement>();
    const startLoops = (act: HTMLElement) => {
      if (loopedActs.has(act)) return;
      loopedActs.add(act);
      loops(act);
    };

    // Ambient motion is independent from the desktop scroll choreography. The
    // observer starts it only once the relevant act is near the viewport, so a
    // short window or phone keeps the living dots without running every loop on
    // the page from first paint.
    const loopObserver = new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          startLoops(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px 15% 0px' },
    );
    acts.forEach((act) => loopObserver.observe(act));

    const DRAW: Record<ActKey, (act: HTMLElement) => gsap.core.Timeline> = {
      alone,
      gear,
      health,
      open,
    };

    /** `dataset` hands back a bare string, so this is where the key is checked
     *  once and trusted afterwards. An act with a key nothing draws is skipped
     *  rather than throwing halfway through building the other three. */
    const drawing = (act: HTMLElement) => {
      const key = act.dataset.act;
      return key && key in DRAW ? DRAW[key as ActKey] : undefined;
    };

    // Crossing the height breakpoint removes or creates several pin spacers at
    // once. Preserve the act the visitor is actually looking at while that
    // document height changes; otherwise a short-window resize can leave the
    // same scrollY pointing several sections farther down the page.
    const headerEdge = 100;
    let activeActBeforeResize: HTMLElement | undefined;
    const rememberActiveAct = () => {
      if (motionQuery.matches) return;
      activeActBeforeResize =
        acts.find((act) => {
          const bounds = act.getBoundingClientRect();
          return bounds.top <= headerEdge && bounds.bottom > headerEdge;
        }) ?? activeActBeforeResize;
    };

    rememberActiveAct();
    window.addEventListener('scroll', rememberActiveAct, { passive: true });

    motionQuery.addEventListener('change', () => {
      const activeAct = activeActBeforeResize;
      if (!activeAct) return;

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          ScrollTrigger.refresh();

          const previousBehavior = document.documentElement.style.scrollBehavior;
          document.documentElement.style.scrollBehavior = 'auto';
          if (motionQuery.matches) {
            const index = Math.max(0, acts.indexOf(activeAct));
            const sectionTop = section.getBoundingClientRect().top + window.scrollY;
            const runway = Math.max(1, section.offsetHeight - window.innerHeight);
            window.scrollTo(0, sectionTop + runway * ((index + 0.2) / acts.length));
          } else {
            activeAct.scrollIntoView({ block: 'start' });
          }
          document.documentElement.style.scrollBehavior = previousBehavior;
          ScrollTrigger.update();
        });
      });
    });

    const mm = gsap.matchMedia();

    // In the natural-flow fallback, the graph still draws when it reaches the
    // viewport. The full desktop stage drives the same timeline from its single
    // shared scroll progress below.
    mm.add('(max-width: 1023px), (max-height: 799px)', () => {
      const healthAct = section.querySelector<HTMLElement>("[data-act='health']");
      if (!healthAct) return;

      const graph = health(healthAct);
      const reveal = ScrollTrigger.create({
        trigger: healthAct.querySelector<HTMLElement>('[data-health-panel]') ?? healthAct,
        start: 'top 92%',
        end: 'top 48%',
        scrub: 0.7,
        invalidateOnRefresh: true,
        animation: graph,
      });

      return () => {
        reveal.kill();
        graph.progress(1).kill();
      };
    });

    mm.add('(min-width: 1024px) and (min-height: 800px)', () => {
      const countLabels = [...section.querySelectorAll<HTMLElement>('[data-gear-count]')].map(
        (element) => ({ element, text: element.textContent }),
      );
      const drawTimelines = acts.map((act) => drawing(act)?.(act).pause(0));
      const clamp = (value: number) => Math.max(0, Math.min(1, value));
      const smoothStep = (start: number, end: number, value: number) => {
        const t = clamp((value - start) / (end - start));
        return t * t * (3 - 2 * t);
      };
      const renderStage = (progress: number) => {
        const travelled = clamp(progress) * acts.length;
        let dominantAct = acts[0];
        let dominantOpacity = -1;

        acts.forEach((act, index) => {
          const q = gsap.utils.selector(act);
          const local = travelled - index;
          const entering = index === 0 ? 1 : smoothStep(0.02, 0.14, local);
          const leaving =
            index === acts.length - 1 ? 1 : 1 - smoothStep(0.86, 0.98, local);
          const opacity = Math.min(entering, leaving);
          const exit = 1 - leaving;

          if (opacity > dominantOpacity) {
            dominantOpacity = opacity;
            dominantAct = act;
          }

          act.style.visibility = opacity > 0.01 ? 'visible' : 'hidden';
          act.style.zIndex = String(index + 1);
          act.style.pointerEvents = opacity > 0.55 ? 'auto' : 'none';
          act.toggleAttribute('data-active', opacity > 0.55);

          gsap.set(q('[data-act-copy]'), {
            y: 74 * (1 - entering) - 74 * exit,
            autoAlpha: opacity,
          });
          gsap.set(q('[data-act-word]'), {
            y: '0%',
          });
          gsap.set(q('[data-act-body]'), {
            y: 10 * (1 - entering) - 10 * exit,
            opacity: 1,
          });
          gsap.set(q('[data-act-visual]'), {
            y: 92 * (1 - entering) - 92 * exit,
            scale: 0.975 + entering * 0.025 + exit * 0.025,
            autoAlpha: opacity,
          });

          drawTimelines[index]?.progress(smoothStep(-0.02, 0.68, local)).pause();
          if (local > -0.05) startLoops(act);
        });

        activeActBeforeResize = dominantAct;
      };

      const stageTrigger = ScrollTrigger.create({
        trigger: section,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.38,
        invalidateOnRefresh: true,
        onUpdate: (self) => renderStage(self.progress),
      });

      renderStage(0);

      return () => {
        stageTrigger.kill();
        drawTimelines.forEach((timeline) => timeline?.progress(1).kill());
        acts.forEach((act) => {
          const q = gsap.utils.selector(act);
          act.removeAttribute('data-active');
          act.style.removeProperty('visibility');
          act.style.removeProperty('z-index');
          act.style.removeProperty('pointer-events');
          gsap.set(q('[data-act-copy], [data-act-word], [data-act-body], [data-act-visual]'), {
            clearProps: 'transform,opacity,visibility',
          });
        });
        countLabels.forEach(({ element, text }) => {
          element.textContent = text;
        });
      };
    });

  }

  // Hero pinning changes document height after the browser's native hash jump.
  // Correct the landing when ScrollTrigger performs its own load refresh. Do
  // not force a second refresh here: refreshing while another component is
  // still installing its pin spacer can corrupt ScrollTrigger's pin DOM.
  if (section) {
    const correctLinkedAct = () => {
      const linkedAct = location.hash
        ? document.getElementById(decodeURIComponent(location.hash.slice(1)))
        : null;
      if (!linkedAct?.matches('[data-act]')) return;

      requestAnimationFrame(() => {
        const previousBehavior = document.documentElement.style.scrollBehavior;
        document.documentElement.style.scrollBehavior = 'auto';
        if (document.documentElement.hasAttribute('data-motion')) {
          const linkedActs = [...section.querySelectorAll<HTMLElement>('[data-act]')];
          const index = Math.max(0, linkedActs.indexOf(linkedAct as HTMLElement));
          const sectionTop = section.getBoundingClientRect().top + window.scrollY;
          const runway = Math.max(1, section.offsetHeight - window.innerHeight);
          window.scrollTo(0, sectionTop + runway * ((index + 0.2) / linkedActs.length));
        } else {
          linkedAct.scrollIntoView({ block: 'start' });
        }
        document.documentElement.style.scrollBehavior = previousBehavior;
        ScrollTrigger.update();
      });
    };

    ScrollTrigger.addEventListener('refresh', correctLinkedAct);
    window.addEventListener('load', correctLinkedAct, { once: true });
  }

</script>
