---
---
<Shell title="Website + app / Three concepts" studio>
  <header class="studio-header"><a href="/" aria-label="Previous Origin89 drafts"><img src={art.logoBlue} alt="Origin89" width="174" height="30"/></a><span>DESIGN STUDIES / 03</span><a href="/">Earlier drafts ↗</a></header>
  <main id="main" class="studio-main">
    <div class="studio-intro"><div><span class="micro">WEBSITE + ORIGIN89 OFFGRID + BUDDY</span><h1>Three ways to feel<br/>like Origin89.</h1></div><p>Same purpose. Different visual language.<br/>Explore the website and app together before choosing a direction.</p></div>
    <div class="concept-choices" aria-label="Choose a visual direction">{directions.map((d,i)=><button class="concept-choice" type="button" data-direction={d.id} aria-pressed={i===0}><div class="choice-preview" aria-hidden="true"><iframe src={`/concepts/${d.id}/`} title={`${d.title} thumbnail`} tabindex="-1" loading="lazy"></iframe><span>{d.letter}</span></div><div class="choice-copy"><span class="micro">{d.letter} / {d.angle}</span><strong>{d.title}</strong><p>{d.description}</p><span class="choice-link">Explore this direction <b>↗</b></span></div></button>)}</div>
    <section class="studio-workbench" aria-labelledby="direction-title">
      <div class="workbench-heading"><div><span class="micro" data-active-letter>CONCEPT A</span><h2 id="direction-title">Site journal</h2></div><p data-active-description>{directions[0].description}</p></div>
      <div class="workbench-controls"><div class="viewport-buttons" aria-label="Website preview size"><button type="button" data-viewport="desktop" aria-pressed="true">Desktop</button><button type="button" data-viewport="mobile" aria-pressed="false">Mobile</button></div><a data-open-web href="/concepts/journal/" target="_blank">Open website ↗</a><a data-open-app href="/concepts/app/journal/" target="_blank">Open app ↗</a></div>
      <div class="preview-pair"><div class="web-preview-column"><div class="preview-label"><span>WEBSITE</span><span data-dimensions>1440 PX / RESPONSIVE</span></div><div class="web-preview-stage" data-web-stage><iframe id="website-preview" src="/concepts/journal/" title="Cottage journal website preview"></iframe></div></div><div class="app-preview-column"><div class="preview-label"><span>ORIGIN89 OFFGRID</span><span>INTERACTIVE CONCEPT</span></div><div class="app-preview-stage"><iframe id="app-preview" src="/concepts/app/journal/" title="Cottage journal mobile app preview"></iframe></div><p class="app-preview-hint">Try Buddy, Energy and Care. Ask a question or change the battery type.</p></div></div>
    </section>
    <section class="studio-decision"><span class="micro">WHAT WE’RE CHOOSING</span><h2>The character of the product.</h2><div><p><strong>A feels personal.</strong> It starts with the cottage and makes the technology approachable.</p><p><strong>B feels useful.</strong> It brings equipment compatibility and Buddy’s practical advice to the front.</p><p><strong>C feels independent.</strong> It makes the open stack and long-term ownership visible.</p></div><p class="studio-recommendation">My starting preference: A’s warmth with B’s clarity in the app. Keep C as a distinct alternative while we compare.</p></section>
    <footer class="studio-footer"><p>Concept exploration, not a finished product. App data and Buddy conversations are illustrative. Battery care follows the equipment type and manufacturer’s guidance. <a href="https://www.trojanbattery.com/resources/guides-manuals-and-warranties" target="_blank" rel="noreferrer">Example source ↗</a></p><p>Original Origin89 logo and Buddy artwork. Real CAD-derived controller image. Generated cottage concept photograph.</p><a href="/next/research/">Research & earlier positioning ↗</a></footer>
  </main>
  <script is:inline define:vars={{directions}}>
    const choices=document.querySelectorAll('[data-direction]');
    const web=document.getElementById('website-preview');
    const app=document.getElementById('app-preview');
    const stage=document.querySelector('[data-web-stage]');
    let viewport='desktop';
    window.addEventListener('message',event=>{
      if(event.origin!==location.origin||event.source!==web.contentWindow||event.data?.type!=='origin89:journal-site')return;
      const site=event.data.site;if(!['cottage','mining','telecom'].includes(site))return;
      if(!document.querySelector('[data-direction="journal"][aria-pressed="true"]'))return;
      const path=site==='cottage'?'/concepts/app/journal/':'/concepts/app/journal/'+site+'/';
      if(new URL(app.src).pathname!==path)app.src=path;
      document.querySelector('[data-open-app]').href=path;
      document.querySelector('[data-open-web]').href='/concepts/journal/?site='+site;
    });
    function fit(){
      const target=viewport==='mobile'?390:1440;
      const scale=Math.min(1,stage.clientWidth/target);
      web.style.width=target+'px';web.style.height=(stage.clientHeight/scale)+'px';web.style.transform='scale('+scale+')';
      stage.dataset.viewport=viewport;
      document.querySelector('[data-dimensions]').textContent=target+' PX / RESPONSIVE';
      document.querySelectorAll('.choice-preview').forEach(el=>{const iframe=el.querySelector('iframe');iframe.style.transform='scale('+(el.clientWidth/1440)+')';});
      const appStage=document.querySelector('.app-preview-stage');const appScale=Math.min(1,appStage.clientWidth/390);app.style.width='390px';app.style.height=(appStage.clientHeight/appScale)+'px';app.style.transform='scale('+appScale+')';
    }
    function choose(id){const d=directions.find(x=>x.id===id);if(!d)return;choices.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.direction===id)));web.src='/concepts/'+id+'/';web.title=d.title+' website preview';app.src='/concepts/app/'+id+'/';app.title=d.title+' mobile app preview';document.getElementById('direction-title').textContent=d.title;document.querySelector('[data-active-letter]').textContent='CONCEPT '+d.letter;document.querySelector('[data-active-description]').textContent=d.description;document.querySelector('[data-open-web]').href=web.src;document.querySelector('[data-open-app]').href=app.src;history.replaceState(null,'','#'+id);fit();}
    choices.forEach(button=>button.addEventListener('click',()=>choose(button.dataset.direction)));
    document.querySelectorAll('[data-viewport]').forEach(button=>button.addEventListener('click',()=>{viewport=button.dataset.viewport;document.querySelectorAll('[data-viewport]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));fit();}));
    new ResizeObserver(fit).observe(stage);fit();if(location.hash)choose(location.hash.slice(1));
  </script>
</Shell>
