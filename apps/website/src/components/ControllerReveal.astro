---
import dimensions from "../assets/product/controller-reveal.json";
import type { Copy } from "../i18n/copy";

interface Props {
  meet: Copy["meet"];
}
const { meet } = Astro.props;
const { reveal } = meet;
const _sizes = "(max-width: 600px) 90vw, 480px";
const { width, height } = dimensions;
---

<div class="case-story" data-case-story data-open="false"
  data-open-label={reveal.open} data-close-label={reveal.close}
  data-closed-title={reveal.closedLabel} data-inside-title={reveal.insideLabel}
  data-closed-description={reveal.closedDescription} data-inside-description={reveal.insideDescription}
  data-closed-alt={meet.alt} data-inside-alt={reveal.insideAlt}>
  <div class="case-sticky">
    <div class="case-scene" id="controller-interior" role="img" aria-label={meet.alt}
      style={`--case-aspect: ${width} / ${height}; --case-ratio: ${width / height}`}>
      <div class="case-glow" aria-hidden="true"></div>
      <div class="case-frame" aria-hidden="true">
       <div class="case-render">
        <img class="case-fallback" src={closedLarge} srcset={`${closedSmall} 640w, ${closedLarge} 1200w`}
          {sizes} {width} {height} alt="" loading="lazy" decoding="async" />
        <div class="case-layers">
          <img class="case-base" src={baseLarge} srcset={`${baseSmall} 640w, ${baseLarge} 1200w`}
            {sizes} {width} {height} alt="" loading="lazy" decoding="async" />
          <picture class="case-cover">
            <source media="(prefers-reduced-motion: no-preference)"
              srcset={`${liveSmall} 640w, ${liveLarge} 1200w`} {sizes} />
            <img src={coverLarge} srcset={`${coverSmall} 640w, ${coverLarge} 1200w`}
              {sizes} {width} {height} alt="" loading="lazy" decoding="async" />
          </picture>
        </div>
       </div>
      </div>
    </div>
    <div class="case-caption">
      <div class="case-caption-copy">
        <p class="case-title" data-case-title>{reveal.closedLabel}</p>
        <p class="case-description" data-case-description>{reveal.closedDescription}</p>
      </div>
      <button type="button" class="case-toggle" aria-expanded="false" aria-controls="controller-interior" hidden>
        <span data-case-button-label>{reveal.open}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="m4 8 8-4 8 4-8 4-8-4Zm0 5 8 4 8-4M4 18l8 4 8-4" />
        </svg>
      </button>
      <div class="case-track" aria-hidden="true"><span class="case-progress"></span></div>
    </div>
  </div>
  <details class="case-static-inside">
    <summary>{reveal.open}</summary>
    <img src={baseLarge} srcset={`${baseSmall} 640w, ${baseLarge} 1200w`} {sizes}
      {width} {height} alt={reveal.insideAlt} loading="lazy" decoding="async" />
    <p>{reveal.insideDescription}</p>
  </details>
</div>

<script>
  import { initializeControllerReveals } from '../lib/controller-reveal';
  initializeControllerReveals();
</script>

<style>
  .case-story { --case-top: 24px; --case-travel: 360px; margin: 3rem auto 3.5rem; overflow-x: clip; }
  .case-story[data-scroll='on']::after { content: ''; display: block; height: var(--case-travel); }
  .case-story[data-scroll='on'] .case-sticky { position: sticky; top: var(--case-top); }
  .case-scene { position: relative; width: min(100%, calc((100svh - 200px) * var(--case-ratio)), 500px); aspect-ratio: var(--case-aspect); margin: 0 auto; isolation: isolate; }
  .case-glow { position: absolute; inset: 10% -10% 12%; background: radial-gradient(ellipse, #6fb89914, transparent 68%); pointer-events: none; }
  .case-frame { position: absolute; inset: -25% -15% 0; overflow: hidden; mask-image: linear-gradient(#000 84%, transparent 99.2%); }
  .case-render { position: absolute; inset: 20% 11.5384615% 0; }
  .case-fallback, .case-layers, .case-base, .case-cover { position: absolute; inset: 0; width: 100%; height: 100%; }
  .case-frame img { width: 100%; height: 100%; object-fit: contain; }
  .case-layers { visibility: hidden; }
  .case-cover { display: block; transform-origin: 50% 32%; }
  .case-base { transform-origin: 50% 40%; }
  [data-ready] .case-fallback { visibility: hidden; }
  [data-ready] .case-layers { visibility: visible; }
  .case-caption { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; max-width: 560px; margin: -.25rem auto 0; padding: 0 0 1.25rem; }
  .case-caption-copy { flex: 1 1 220px; }
  .case-title { font-size: 1.05rem; font-weight: 500; letter-spacing: -.02em; }
  .case-description { margin-top: .35rem; color: var(--color-muted); font-size: .8rem; line-height: 1.5; min-height: 2.4em; }
  .case-toggle { display: inline-flex; align-items: center; justify-content: center; gap: .65rem; min-height: 44px; padding: .65rem 1rem; border: 1px solid #8aa99a4d; border-radius: 999px; background: #a4e6ca08; font-size: .78rem; white-space: nowrap; cursor: pointer; }
  .case-toggle[hidden] { display: none; }
  .case-toggle:hover { background: #a4e6ca14; border-color: #8aa99a80; }
  .case-toggle:focus-visible, summary:focus-visible { outline: 2px solid #97dfb9; outline-offset: 4px; }
  .case-track { position: absolute; inset: auto 0 0; height: 1px; background: #bfd9cc24; visibility: hidden; }
  [data-scroll='on'] .case-track { visibility: visible; }
  .case-progress { display: block; height: 100%; background: #8dcbb0; transform: scaleX(0); transform-origin: left; }
  .case-static-inside { max-width: 500px; margin: 1rem auto; font-size: .85rem; color: var(--color-muted); }
  .case-static-inside summary { cursor: pointer; padding: .75rem 0; color: var(--color-fg); }
  .case-static-inside img { width: 100%; height: auto; mask-image: linear-gradient(#000 80%, transparent 99%); }
  [data-ready] .case-static-inside { display: none; }
  .case-story:not([data-scroll='on']) .case-description { visibility: hidden; }
  .case-story[data-open='true'] .case-description { visibility: visible; }
  @media (min-width: 768px) {
    .case-story { --case-top: 112px; --case-travel: 600px; margin-top: 4rem; }
    .case-scene { width: min(100%, calc((100svh - 230px) * var(--case-ratio)), 500px); }
  }
  @media (max-width: 480px) {
    .case-caption { gap: .6rem; }
    .case-caption-copy { flex-basis: 170px; }
    .case-toggle { padding-inline: .8rem; }
  }
  @media (max-height: 599px) {
    .case-scene { width: min(100%, 360px); }
  }
</style>
