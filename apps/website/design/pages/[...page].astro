---
import { type Direction, directions, href, pages, products, solutions } from "../lib/content";

export function getStaticPaths() {
  return directions.flatMap((direction) =>
    pages.map((page) => ({
      params: { page: `${direction}${page ? `/${page}` : ""}` },
      props: { direction, page },
    })),
  );
}
interface Props {
  direction: Direction;
  page: string;
}
const { direction, page } = Astro.props;
const _url = (path = "") => href(direction, path);
const product = products.find((p) => page === `products/${p.slug}`);
const solution = solutions.find((s) => page === `solutions/${s.slug}`);
const titles: Record<string, string> = {
  "": "Your corner. Your control.",
  products: "The product family",
  solutions: "Built around your site",
  compatibility: "Equipment compatibility",
  developers: "Build with Origin89",
  about: "Our story",
  contact: "Tell us about your site",
};
const _title = product ? `Origin89 ${product.name}` : solution ? solution.name : titles[page];
---
<Shell title={title} direction={direction} page={page}>
  {page === '' && <Home direction={direction} />}

  {page === 'products' && <>
    <section class="page-intro wrap"><span class="eyebrow">The Origin89 family</span><h1>Your site.<br /><em>Working together.</em></h1><p>Hardware, an app and a helpful assistant.<br />Each has a clear role. Together, they make your site easier to understand.</p></section>
    <section class="wrap"><ProductCards direction={direction} /></section>
    <section class="section wrap"><div class="section-heading"><div><span class="eyebrow">A clear job for each part</span><h2>Here’s how it fits.</h2></div><p>You configure the site. The Controller runs its rules. Offgrid brings the information into view, with Buddy beside the task.</p></div><div class="system-flow"><div><span class="eyebrow">Your equipment</span><h3>Power. Heat.<br />Water. Field gear.</h3></div><span aria-hidden="true">↔</span><a href={url('products/controller')}><span class="eyebrow">At your site</span><h3>Controller</h3><p>Connects & runs rules</p></a><span aria-hidden="true">↔</span><a href={url('products/offgrid')}><span class="eyebrow">In your hands</span><h3>Offgrid + Buddy</h3><p>See, configure & understand</p></a></div>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Product role comparison"><table><caption>Compare the roles of the Origin89 products</caption><thead><tr><th>What you need</th><th>Controller</th><th>Offgrid</th><th>Buddy</th></tr></thead><tbody><tr><th>Connect to field equipment</th><td>Physical interfaces</td><td>Equipment view</td><td>Explain the setup</td></tr><tr><th>Run configured site rules</th><td>At the site</td><td>Review & configure</td><td>Explain a choice</td></tr><tr><th>Understand a reading</th><td>Value, quality & time</td><td>Overview & details</td><td>Context & next checks</td></tr><tr><th>Where it lives</th><td>Hardware at your site</td><td>Your site app</td><td>In the app & docs</td></tr></tbody></table></div></section>
    <section class="wrap quiet-panel"><span class="eyebrow">Product status</span><h3>We’re building the family.</h3><p>Origin89 is in active development. These pages present the intended experience. Talk to us about equipment fit and early installations.</p><a class="text-link" href={url('contact')}>Discuss your site ↗</a></section><Callout direction={direction} />
  </>}

  {product && <>
    <section class:list={['product-hero', 'wrap', `hero-${product.slug}`]}><div><a class="eyebrow breadcrumb" href={url('products')}>Products / Origin89 {product.name}</a><h1>{product.headline}</h1><p>{product.description}</p><div class="actions"><a class="button" href={url('contact')}>Talk about your setup ↗</a><a class="text-link" href="#details">Explore {product.name} ↓</a></div><span class="note">In development</span></div><div class="product-hero-art">{product.slug === 'offgrid' ? <Dashboard interactive /> : <><img src={art[product.art]} alt={product.slug === 'controller' ? 'CAD-based Controller render with earlier enclosure branding' : 'Buddy, the Origin89 assistant'} /><span class="art-caption">{product.slug === 'controller' ? 'CAD render · enclosure artwork predates Plate 89' : 'From the shared editable Buddy library'}</span></>}</div></section>
    <section class="section wrap" id="details"><div class="section-heading"><div><span class="eyebrow">Designed for a useful job</span><h2>{product.slug === 'controller' ? 'Built around the site.' : product.slug === 'offgrid' ? 'Clarity, at every level.' : 'Help that stays helpful.'}</h2></div></div><div class="three-columns">{product.details.map(([heading,body], i) => <article><span class="eyebrow">0{i+1}</span><h3>{heading}</h3><p>{body}</p></article>)}</div></section>
    {product.slug === 'controller' && <section class="inside-panel"><div class="wrap feature-split"><div><span class="eyebrow">A closer look</span><h2>The thinking<br />stays on site.</h2><p>The Controller is designed to keep configured decisions close to the equipment. Your app gives you a way to see and configure the site.</p><p>Explore the board behind the enclosure.</p><details class="board-disclosure"><summary>Show the board ↗</summary><img src={art.board} alt="Controller PCB, mounting plate and harness from the existing CAD source" loading="lazy" /></details></div><div class="controller-inside-art"><img src={art.board} alt="Controller with the cover removed" loading="lazy" /></div></div></section>}
    {product.slug === 'offgrid' && <section class="wrap quiet-panel"><span class="eyebrow">Your layout, your priorities</span><h2>Put the important things first.</h2><p>A cottage may start with batteries and temperature. A pump station may start with tank levels and equipment state. The app should follow the way you think about your site.</p><div class="tag-list"><span>Site overview</span><span>Equipment details</span><span>History & events</span><span>Buddy</span></div></section>}
    {product.slug === 'buddy' && <section class="buddy-example wrap"><img src={art.reserve} alt="Buddy beside stationary storage under an umbrella, a visual metaphor for conserving reserves" loading="lazy" /><div><span class="eyebrow">Example / A probe stopped reporting</span><h2>Start with what<br />you actually know.</h2><div class="conversation"><span>Buddy</span><p>“The last reading was 12 minutes ago. Check the probe connection, then check whether readings resume.”</p><a class="text-link" href={url('developers')}>Explore the documentation path ↗</a></div><span class="note">Illustrative assistant copy. A suggestion does not change equipment.</span></div></section>}
    <section class="section wrap feature-split"><div><span class="eyebrow">At a glance</span><h2>Origin89 {product.name}.</h2><p>A clear place in the family.</p><a class="text-link" href={url('products')}>Compare product roles ↗</a></div><dl class="specs">{product.specs.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>
    <Callout direction={direction} />
  </>}

  {page === 'solutions' && <>
    <section class="page-intro wrap"><span class="eyebrow">Your site comes first</span><h1>Different places.<br /><em>The same care.</em></h1><p>Start with your equipment, the readings you need and the things you want to make easier.</p></section>
    <section class="wrap solution-index">{solutions.map(s => <a href={url(`solutions/${s.slug}`)}><span class="eyebrow">{s.number} / {s.tag}</span><h2>{s.name}</h2><p>{s.description}</p><div class="tag-list">{s.equipment.map(item => <span>{item}</span>)}</div><span class="text-link">Explore this setup ↗</span></a>)}</section><Callout direction={direction} />
  </>}

  {solution && <>
    <section class="solution-hero"><img src={art.forest} alt="Spruce forest, setting the scene for remote equipment" /><div class="wrap"><a class="eyebrow breadcrumb" href={url('solutions')}>Your site / {solution.name}</a><h1>{solution.headline}</h1><p>{solution.description}</p><a class="button pale" href={url('contact')}>Tell us about your site ↗</a></div></section>
    <section class="section wrap"><div class="section-heading"><div><span class="eyebrow">Start with the useful questions</span><h2>What matters<br />at your site?</h2></div><p>An example of how Origin89 could fit this type of site. Equipment fit and the scope of each installation are reviewed together.</p></div><div class="three-columns">{solution.tasks.map(([heading,body], i) => <article><span class="eyebrow">0{i+1}</span><h3>{heading}</h3><p>{body}</p></article>)}</div></section>
    <section class="wrap feature-split quiet-panel"><div><span class="eyebrow">The equipment conversation</span><h2>Bring your setup.</h2><p>Exact models, existing interfaces and the tasks you have in mind give us a practical starting point.</p><a class="text-link" href={url('compatibility')}>How compatibility works ↗</a></div><div class="equipment-stack">{solution.equipment.map((item,i) => <div><span>0{i+1}</span><h3>{item}</h3><span aria-hidden="true">↗</span></div>)}</div></section><section class="section wrap"><div class="section-heading"><div><span class="eyebrow">One family, shaped around your site</span><h2>The pieces that bring it together.</h2></div></div><ProductCards direction={direction} /></section><Callout direction={direction} />
  </>}

  {page === 'compatibility' && <>
    <section class="page-intro wrap"><span class="eyebrow">Equipment compatibility</span><h1>Start with the gear<br /><em>already there.</em></h1><p>A useful connection starts with the exact model, its interface and what you want to do with it.</p></section>
    <section class="wrap compatibility-tool"><div class="filter-heading"><h2>Explore the connections.</h2><label>Equipment category <select data-equipment-filter><option value="all">All equipment</option><option value="power">Power & batteries</option><option value="water">Pumps & water</option><option value="field">Field equipment</option></select></label></div><p class="note">Interface examples for scoping a site. These are not a list of certified or shipping integrations.</p><div class="connection-rows">
    {[
      ['power', 'Solar & battery equipment', 'RS-485 / Modbus · CAN · VE.Direct', 'Exact device model, firmware and available readings'],
      ['power', 'Backup generators', 'Compatible remote-start interface · dry contacts', 'Start interface and independent proof of running'],
      ['water', 'Pumps, valves & tank levels', 'Modbus · dry contacts · sensor inputs', 'Signal type, measurement range and intended task'],
      ['field', 'Temperature & field sensors', '1-Wire · 4–20 mA through suitable input hardware', 'Sensor model, wiring and site conditions'],
    ].map(([category,name,interfaces,check]) => <article data-category={category}><h3>{name}</h3><div><span class="eyebrow">Typical interface</span><p>{interfaces}</p></div><div><span class="eyebrow">What to confirm</span><p>{check}</p></div></article>)}</div><p class="filter-status note" aria-live="polite" data-filter-status>Showing all 4 equipment groups.</p></section>
    <section class="section wrap"><div class="section-heading"><div><span class="eyebrow">From catalogue to installation</span><h2>A clear path to a useful fit.</h2></div></div><div class="three-columns"><article><span class="eyebrow">01 / Identify</span><h3>Know the exact equipment.</h3><p>Manufacturer, model, firmware and interface. A series name on its own leaves too much open.</p></article><article><span class="eyebrow">02 / Define</span><h3>Name the task.</h3><p>Reading a tank level and operating a pump are different requests. Start with what your site needs.</p></article><article><span class="eyebrow">03 / Review</span><h3>Confirm the installation.</h3><p>A documented device is a research starting point. Support and the installation scope need their own confirmation.</p></article></div></section><Callout direction={direction} />
  </>}

  {page === 'developers' && <>
    <section class="page-intro wrap"><span class="eyebrow">Developers & integrators</span><h1>Go a little<br /><em>deeper.</em></h1><p>Understand the architecture, inspect the protocol and find the sources behind the equipment research.</p><a class="button" href={SITE.docsUrl}>Open the documentation ↗</a></section>
    <section class="wrap developer-grid"><article class="protocol-card"><span class="eyebrow">The protocol</span><h2>KM43</h2><p>The technical protocol connecting Origin89 Controller and its clients. A documented wire format with a clear place in the system.</p><div class="wire-flow"><span>CLIENT</span><span>↔</span><span>KM43</span><span>↔</span><span>CONTROLLER</span></div><a href={SITE.docsUrl} class="text-link">Read the protocol docs ↗</a></article><div class="resource-list"><a href={SITE.docsUrl}><span class="eyebrow">01 / Architecture</span><h3>Understand the Controller ↗</h3><p>Local decisions, client boundaries and the equipment interfaces.</p></a><a href={SITE.docsUrl}><span class="eyebrow">02 / Protocol</span><h3>Messages, registries & vectors ↗</h3><p>Technical reference for people building a client or integration.</p></a><a href={url('compatibility')}><span class="eyebrow">03 / Equipment</span><h3>Start an integration discussion ↗</h3><p>Exact models, interfaces and intended measurements.</p></a></div></section>
    <section class="section wrap feature-split"><div><span class="eyebrow">One source of control</span><h2>A clear boundary<br />makes a better system.</h2></div><div><p>The Controller owns configured site decisions. Offgrid and other clients provide ways to inspect and configure it.</p><p>KM43 is the protocol name. Hardware and firmware belong to Origin89 Controller.</p><a class="text-link" href={url('products')}>See the product architecture ↗</a></div></section><Callout direction={direction} />
  </>}

  {page === 'about' && <>
    <section class="page-intro wrap"><span class="eyebrow">Our story / Québec</span><h1>Built for a place<br /><em>we care about.</em></h1><p>Origin89 starts with a practical question: how do you understand and look after equipment at a place you cannot always be?</p></section><div class="story-photo wrap"><img src={art.forest} alt="Spruce trees in a remote woodland" loading="lazy" /><span>From the cottage to the field.</span></div>
    <section class="section wrap story-copy"><span class="eyebrow">A useful starting point</span><div><h2>Real equipment.<br />Real reasons to care.</h2><p>A battery bank. A cold building. A generator at the end of the road. Equipment decisions become personal when the place matters to you.</p><p>We’re building Origin89 to bring that equipment into a clearer view, with control at the site and understandable settings in your hands.</p><p>The same approach has room for pumps, valves and field sensors. Simple at the cottage. Capable in the field.</p></div></section>
    <section class="wrap three-columns values"><article><span class="eyebrow">01</span><h3>Useful.</h3><p>Start with the person’s site and the task they want to make easier.</p></article><article><span class="eyebrow">02</span><h3>Adaptable.</h3><p>Make room for different equipment and the way each owner wants to see it.</p></article><article><span class="eyebrow">03</span><h3>Grounded.</h3><p>Say what is measured, what is missing and what still needs to be checked.</p></article></section><Callout direction={direction} />
  </>}

  {page === 'contact' && <>
    <section class="page-intro wrap"><span class="eyebrow">Let’s start with your site</span><h1>Tell us what’s<br /><em>out there.</em></h1><p>What is installed? What keeps you driving out there?<br />What would you like to make easier?</p></section><section class="wrap contact-grid"><div class="contact-panel"><span class="eyebrow">Start a conversation</span><h2>Every setup has<br />its own story.</h2><p>Send us a short description of your site and equipment. Model numbers and the tasks you have in mind help us start in the right place.</p><a class="button" href={`mailto:${SITE.email}?subject=${encodeURIComponent('My site / Origin89')}&body=${encodeURIComponent('Hi Origin89,\n\nMy type of site:\n\nEquipment and exact models:\n\nWhat I would like to monitor or control:\n\nConnectivity and site constraints:\n\nThanks!')}`}>Write to {SITE.email} ↗</a><span class="note">Opens a draft in your email app. You review and send it.</span></div><aside><span class="eyebrow">Where we are</span><h3>In active development.</h3><p>We’re discussing real sites and equipment as the product takes shape.</p><p>Pricing, shipping dates and supported app platforms will be announced as they are confirmed.</p><a class="text-link" href={url('products')}>Explore the family ↗</a></aside></section>
    <section class="section wrap faq"><div><span class="eyebrow">A few practical details</span><h2>Before we talk.</h2></div><div>{faqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
  </>}
</Shell>
<script>
  const filter = document.querySelector<HTMLSelectElement>('[data-equipment-filter]');
  filter?.addEventListener('change', () => {
    let count = 0;
    document.querySelectorAll<HTMLElement>('[data-category]').forEach(row => {
      row.hidden = filter.value !== 'all' && row.dataset.category !== filter.value;
      if (!row.hidden) count++;
    });
    const status = document.querySelector('[data-filter-status]');
    if (status) status.textContent = `Showing ${filter.value === 'all' ? 'all ' : ''}${count} equipment ${count === 1 ? 'group' : 'groups'}.`;
  });
</script>
