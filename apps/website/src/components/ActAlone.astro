---
// The cloud link dies and the local queue keeps filling. The entries are the
// real ones from the phone mock-up — same times, same events — because grey
// placeholder bars would not prove that anything was retained offline.
//
// They are drawn oldest at the top so they stack downward as the animation
// plays. The phone fills only after the link returns: control never stopped,
// the cloud simply caught up.
//
// The lamp pulse is deliberately not scrubbed. Everything else answers to the
// scroll position, so a reader who stops sees a still frame, and a still frame
// of this act with a dead lamp would say the controller had stopped too.
//
// Hidden from screen readers: the paragraph beside it already says the link
// drops and it keeps deciding, and the same notification text is read out
// properly on the phone in the hero.
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;

/** Oldest first: the log is being written, not scrolled. */
const _ENTRIES = [...copy.phone.notifications].reverse().map((entry, i) => ({
  ...entry,
  y: 204 + i * 27,
}));
---

<svg viewBox="0 0 420 348" class="h-auto w-full" aria-hidden="true">
  <g data-alone-phone>
    <rect
      x="190"
      y="4"
      width="40"
      height="64"
      rx="7"
      class="fill-surface stroke-line-strong"
      stroke-width="1.5"></rect>
    <rect data-alone-screen x="195" y="11" width="30" height="50" rx="3" class="fill-info"
    ></rect>
    {
      [15, 27, 39].map((y) => (
        <rect data-alone-note x="198" y={y} width="24" height="9" rx="2" class="fill-page/70" />
      ))
    }
  </g>

  <path
    data-alone-link
    d="M210 72 V104 M210 85 H240"
    fill="none"
    class="stroke-info"
    stroke-width="1.5"
    stroke-dasharray="4 5"
    stroke-linecap="round"></path>

  <g>
    <rect
      x="240"
      y="74"
      width="68"
      height="22"
      rx="8"
      class="fill-surface stroke-line-strong"
      stroke-width="1.2"></rect>
    <text
      x="274"
      y="88"
      text-anchor="middle"
      class="fill-faint font-mono text-[8px] tracking-[0.14em]"
    >
      {copy.actLabels.cloud.toUpperCase()}
    </text>
  </g>

  <g data-alone-cut>
    <path
      d="M203 81 L217 95 M217 81 L203 95"
      class="stroke-faint"
      stroke-width="1.6"
      stroke-linecap="round"></path>
    <!-- Left of the cut, not right. On the right it sat in the 38 units between
         the phone and the controller and read as a label on the box. -->
    <text
      x="194"
      y="92"
      text-anchor="end"
      class="fill-faint font-mono text-[9px] tracking-widest">
      {copy.actLabels.linkLost.toUpperCase()}
    </text>
  </g>

  <rect
    x="40"
    y="106"
    width="340"
    height="58"
    rx="12"
    class="fill-surface-raised stroke-mtq-green-lit/45"
    stroke-width="1.5"></rect>

  <circle
    data-alone-lamp="72 135"
    cx="72"
    cy="135"
    r="21"
    class="fill-mtq-green-lit"
    opacity="0.14"
  ></circle>
  <image href={origin89Badge.src} x="54" y="117" width="36" height="36"></image>

  <text x="104" y="140" class="fill-fg font-display text-[10px] tracking-[0.08em]">
    ORIGIN 89
  </text>

  <text x="40" y="192" class="fill-faint font-mono text-[9px] tracking-widest">
    {copy.actLabels.queue.toUpperCase()}
  </text>
  <text
    x="380"
    y="192"
    text-anchor="end"
    class="fill-faint font-mono text-[8.5px] tracking-[0.12em]"
  >
    {String(ENTRIES.length).padStart(2, '0')} EVENTS RETAINED
  </text>

  {
    ENTRIES.map((entry) => (
      <g data-alone-entry>
        <circle cx="45" cy={entry.y + 5} r="2.6" class="fill-faint" />
        <text x="58" y={entry.y + 9} class="fill-faint font-mono text-[9.5px]">
          {entry.when}
        </text>
        <text x="122" y={entry.y + 9} class="fill-fg/80 text-[11px]">
          {entry.title}
        </text>
        <text
          x="375"
          y={entry.y + 9}
          text-anchor="end"
          class="fill-info/75 font-mono text-[9.5px]"
        >
          {entry.metric}
        </text>
      </g>
    ))
  }
</svg>
