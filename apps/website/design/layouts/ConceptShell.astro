---
import "../../src/react/styles/concepts.css";
import "../../src/react/styles/journal.css";
import "../../src/react/styles/buddy-setup.css";
import "../../src/react/styles/ui.css";
interface Props {
  title: string;
  direction?: string;
  studio?: boolean;
}
const { title, direction = "", studio = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="noindex, nofollow"/>
  <title>{title} · Origin89 concepts</title>
  <link rel="icon" href={art.plate} type="image/svg+xml"/>
  <style is:inline set:html={`@font-face{font-family:Concept;src:url('${art.inter}') format('truetype');font-weight:100 900;font-display:swap}@font-face{font-family:Technical;src:url('${art.mono}') format('truetype');font-weight:400;font-display:swap}`} />
</head>
<body class:list={['concept',direction,{studio}]}><a class="skip-link" href="#main">Skip to content</a><slot /></body>
</html>
