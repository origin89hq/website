---
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
  active?: boolean;
}
const { copy, active = false } = Astro.props;
const { phone } = copy;
---

<div class:list={['o89-view px-4', active && 'is-on']} data-screen="power">
  <p class="px-1 pt-5 font-mono text-[0.58rem] tracking-widest uppercase text-white/40">
    {phone.power.label}
  </p>
  <p class="mt-0.5 px-1 text-[1.25rem] leading-none font-medium tracking-tight text-white">
    {phone.siteName}
  </p>

  <!-- Source at the top, then it splits. A list of three numbers cannot show
       that the array feeds the batteries and the loads at the same time; a fork
       can. Per-circuit sits underneath because that is the part a total never
       answers: which thing is actually drawing. -->
  <div class="mt-4 flex flex-col items-center">
    <div
      class="flex h-[5.6rem] w-[5.6rem] flex-col items-center justify-center rounded-full border-2 border-warning/45 bg-warning/10"
    >
      <span
        data-power-count="source"
        class="font-mono text-[1.3rem] leading-none text-warning tabular-nums"
      >
        {phone.power.source.value.replace(' W', '')}
      </span>
      <span class="mt-0.5 font-mono text-[0.5rem] tracking-widest uppercase text-warning/70">W</span>
    </div>
    <span class="mt-1.5 text-[0.68rem] text-white/60">{phone.power.source.label}</span>

    <svg viewBox="0 0 120 34" class="mt-1 h-[2.1rem] w-full max-w-[11rem]" aria-hidden="true">
      <path
        d="M60 0 V10 M60 10 Q60 20 44 20 H26 M60 10 Q60 20 76 20 H94"
        fill="none"
        class="stroke-white/20"
        stroke-width="1.4"></path>
      <path d="M26 20 l4 -3 v6 z" class="fill-info/70"></path>
      <path d="M94 20 l-4 -3 v6 z" class="fill-white/45"></path>
    </svg>
  </div>

  <ul class="grid grid-cols-2 gap-2">
    {
      phone.power.branches.map((node) => (
        <li class="rounded-[1.1rem] border border-white/10 bg-white/[0.06] px-3 py-3 text-center">
          <span
            data-power-count={node.kind}
            class:list={[
              'block font-mono text-[1.05rem] leading-none tabular-nums',
              POWER_ACCENT[node.kind].text,
            ]}
          >
            {node.value}
          </span>
          <span class="mt-1.5 block text-[0.62rem] leading-tight text-white/55">{node.label}</span>
        </li>
      ))
    }
  </ul>

  <p class="mt-4 px-1 font-mono text-[0.54rem] tracking-widest uppercase text-white/35">
    {phone.power.circuitsLabel}
  </p>
  <ul class="mt-1.5 overflow-hidden rounded-[1.1rem] border border-white/10 bg-white/[0.06]">
    {
      phone.power.circuits.map((circuit) => (
        <li class="flex items-baseline justify-between gap-3 border-b border-white/8 px-3.5 py-2.5 last:border-b-0">
          <span class="text-[0.7rem] text-white/65">{circuit.label}</span>
          <span data-power-count="circuit" class="font-mono text-[0.8rem] text-white tabular-nums">
            {circuit.value}
          </span>
        </li>
      ))
    }
  </ul>

  <!-- Today against the best day in the log, not against a modelled maximum.
       The controller keeps downsampled history; it has no model of the sun. -->
  <div class="mt-3 rounded-[1.1rem] border border-white/10 bg-white/[0.06] px-3.5 py-3">
    <div class="flex items-baseline justify-between gap-3">
      <span class="text-[0.7rem] text-white/65">{phone.power.today.label}</span>
      <span data-power-count="today" class="font-mono text-[0.95rem] text-warning tabular-nums">
        {phone.power.today.value}
      </span>
    </div>
    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/10">
      <div
        data-power-bar={phone.power.todayPercent}
        class="h-full rounded-full bg-warning/70"
        style={`width: ${phone.power.todayPercent}%`}
      >
      </div>
    </div>
    <div class="mt-2 flex items-baseline justify-between gap-3">
      <span class="text-[0.6rem] text-white/40">{phone.power.best.label}</span>
      <span data-power-count="best" class="font-mono text-[0.68rem] text-white/45 tabular-nums">
        {phone.power.best.value}
      </span>
    </div>
  </div>
</div>
