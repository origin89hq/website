---
// The controller, rendered from the real CAD (tools/enclosure/render/):
// the wall-hung 132 x 157 box with clean branding, side ports,
// plugged field row and the cable harness. Editable source: tools/enclosure/blender/.
// See src/assets/product/README.md
// for what the object is and how the webps regenerate.
//
// The inline SVG below is the original placeholder drawing, kept as the
// fallback if both renders are ever removed. It shows an older concept
// (RJ45 shells, rotary selector, external antenna) that the shipped board
// does not have -- trust the render, not the drawing.

const renders = import.meta.glob("../assets/product/controller.{webp,png,jpg}", {
  eager: true,
  query: "?url",
  import: "default",
}) as Record<string, string>;

// controller-live.webp animates the single status light's slow heartbeat.
// It is served only when the visitor allows motion; the still render is the
// fallback and the only image reduced-motion visitors ever see.
const liveRenders = import.meta.glob("../assets/product/controller-live.webp", {
  eager: true,
  query: "?url",
  import: "default",
}) as Record<string, string>;

const _render = Object.values(renders)[0];
const _live = Object.values(liveRenders)[0];

interface Props {
  alt: string;
  class?: string;
}
const { alt, class: className } = Astro.props;

const body = { x: 44, y: 42, w: 232, h: 130 };
const _midY = body.y + body.h / 2;

/** Buses that come on a cable somebody else made. */
const _rj45 = [0, 1, 2].map((i) => ({ x: body.x + 22 + i * 26 }));
const _veDirect = [0, 1].map((i) => ({ x: body.x + 112 + i * 18 }));

/** Field wiring, on pluggable screw blocks. Five positions each. */
const _blocks = [0, 1, 2].map((i) => ({ x: body.x + 24 + i * 62 }));
---

{
  render && live ? (
    <picture>
      <source media="(prefers-reduced-motion: no-preference)" srcset={live} type="image/webp" />
      <img src={render} alt={alt} loading="lazy" class:list={[className, 'device-render']} />
    </picture>
  ) : render ? (
    <img src={render} alt={alt} loading="lazy" class:list={[className, 'device-render']} />
  ) : (
    <svg viewBox="30 16 260 172" role="img" aria-label={alt} class={className}>
      <defs>
        <linearGradient id="dev-body" x1="0" y1="0" x2="0.25" y2="1">
          <stop offset="0" stop-color="#262e37" />
          <stop offset="0.5" stop-color="#1a212a" />
          <stop offset="1" stop-color="#11171e" />
        </linearGradient>
        <radialGradient id="dev-glow">
          <stop offset="0" stop-color="var(--color-warning)" stop-opacity="0.5" />
          <stop offset="1" stop-color="var(--color-warning)" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="dev-shadow">
          <stop offset="0" stop-color="#000000" stop-opacity="0.6" />
          <stop offset="1" stop-color="#000000" stop-opacity="0" />
        </radialGradient>
      </defs>

      <ellipse cx="160" cy="182" rx="112" ry="10" fill="url(#dev-shadow)" />

      <rect x={body.x} y={body.y} width={body.w} height={body.h} rx="9" fill="url(#dev-body)" />
      <rect
        x={body.x + 0.75}
        y={body.y + 0.75}
        width={body.w - 1.5}
        height={body.h - 1.5}
        rx="8.25"
        fill="none"
        stroke="#ffffff"
        stroke-opacity="0.08"
        stroke-width="1.5"
      />

      {/* Wi-Fi and BLE are the only way anything talks to this, and it lives in
          a metal-ish electrical corner, so the antenna is external. */}
      <g>
        <rect x={body.x + 196} y={body.y - 5} width="9" height="7" rx="1.5" fill="#2a323b" />
        <rect x={body.x + 198} y={body.y - 26} width="5" height="22" rx="2.5" fill="#12181f" />
        <rect x={body.x + 199.2} y={body.y - 25} width="1.4" height="19" rx="0.7" fill="#2f3841" />
      </g>

      {/* Top edge: the buses that arrive on a made cable. RJ45 shells carrying
          RS-485 and CAN, deliberately without link lights: these are not network
          ports, and EPEver puts +5 V on pins 1 and 2. */}
      <g opacity="0.8">
        {rj45.map((j) => (
          <g>
            <rect x={j.x} y={body.y + 7} width="20" height="17" rx="1.8" fill="#0a0e13" />
            <rect x={j.x + 2.5} y={body.y + 9} width="15" height="11" rx="1" fill="#151b22" />
            <rect x={j.x + 7.5} y={body.y + 18} width="5" height="4" rx="0.8" fill="#151b22" />
          </g>
        ))}
        {veDirect.map((j) => (
          <rect x={j.x} y={body.y + 10} width="12" height="11" rx="1.5" fill="#0a0e13" />
        ))}
      </g>

      {/* Bottom edge: field wiring, on pluggable blocks. */}
      <g opacity="0.8">
        {blocks.map((b) => (
          <g>
            <rect x={b.x} y={body.y + body.h - 26} width="54" height="18" rx="2" fill="#0b0f14" />
            {[0, 1, 2, 3, 4].map((i) => (
              <circle cx={b.x + 7 + i * 10} cy={body.y + body.h - 17} r="2.6" fill="#1e252d" />
            ))}
          </g>
        ))}
      </g>

      {/* Auto / off / manual. Being told beats guessing. */}
      <circle cx={body.x + 44} cy={midY} r="15" fill="#0d1218" stroke="#39434e" stroke-width="1.2" />
      <line
        x1={body.x + 44}
        y1={midY}
        x2={body.x + 44}
        y2={midY - 10}
        stroke="#e7eaee"
        stroke-width="2.4"
        stroke-linecap="round"
      />
      {[-54, 0, 54].map((deg) => {
        const r = (deg - 90) * (Math.PI / 180);
        return (
          <circle
            cx={body.x + 44 + Math.cos(r) * 22}
            cy={midY + Math.sin(r) * 22}
            r="1.5"
            fill="#5c6672"
          />
        );
      })}

      {/* One light, on because it is awake. */}
      <circle cx={body.x + 84} cy={midY} r="12" fill="url(#dev-glow)" />
      <circle cx={body.x + 84} cy={midY} r="3.6" fill="var(--color-warning)" />

      {/* Moulded into the case rather than printed on a plate. Drawn twice: a
          dark copy dropped one unit down is the shadow the raised letters cast. */}
      <g font-family="Inter Tight, ui-sans-serif, sans-serif" text-anchor="middle">
        <text x={body.x + 166} y={midY - 1} font-size="15" font-weight="600" letter-spacing="1.2" fill="#0e141a">
          ORIGIN89
        </text>
        <text x={body.x + 166} y={midY - 2} font-size="15" font-weight="600" letter-spacing="1.2" fill="#3b444f">
          ORIGIN89
        </text>
        <text x={body.x + 166} y={midY + 13} font-size="7.5" letter-spacing="2.6" fill="#0e141a">
          KM43
        </text>
        <text x={body.x + 166} y={midY + 12} font-size="7.5" letter-spacing="2.6" fill="#333c46">
          KM43
        </text>
      </g>
    </svg>
  )
}

<style>
  /* The renders crop the cable runs at the file edge; a mask dissolves them
     into the page instead of ending them on a hard line. */
  .device-render {
    -webkit-mask-image: linear-gradient(to bottom, black 74%, transparent 96%);
    mask-image: linear-gradient(to bottom, black 74%, transparent 96%);
  }
</style>
