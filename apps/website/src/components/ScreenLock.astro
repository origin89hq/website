---
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
  active?: boolean;
  /** On a real mobile device this becomes an in-app event view, avoiding a
   *  second lock-screen clock inside Safari. */
  embedded?: boolean;
}
const { copy, active = false, embedded = false } = Astro.props;
const { phone } = copy;
---

<div class:list={['o89-view relative h-full', active && 'is-on']} data-screen="generator">
  <!-- A full lock-screen wallpaper in the Origin 89 palette. The broad blurred
       shapes give the glass notification something real to refract. -->
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[radial-gradient(110%_75%_at_110%_10%,rgba(63,97,179,0.38),transparent_58%),radial-gradient(100%_80%_at_-10%_90%,rgba(233,161,60,0.3),transparent_62%),linear-gradient(155deg,#101923_0%,#07110e_52%,#17110b_100%)]"
  >
    <div
      class="absolute -right-20 top-24 h-52 w-72 rotate-[-18deg] rounded-[50%] border border-white/8 bg-action-lit/12 blur-[2px]"
    >
    </div>
    <div
      class="absolute -bottom-20 -left-24 h-52 w-80 rotate-[24deg] rounded-[50%] border border-warning/15 bg-warning/8 blur-[1px]"
    >
    </div>
  </div>

  {
    embedded ? (
      <div class="relative z-[1] px-5 pt-5 text-white">
        <p class="font-mono text-[0.58rem] tracking-widest uppercase text-white/40">
          {copy.actLabels.queue}
        </p>
        <p class="mt-0.5 text-[1.25rem] leading-none font-medium tracking-tight">
          {phone.siteName}
        </p>
      </div>
    ) : (
      <div class="relative z-[1] px-6 pt-7 text-center text-white">
        <p class="text-[0.78rem] font-medium text-white/80">{phone.lockDate}</p>
        <p class="mt-1 text-[4.15rem] leading-none font-light tracking-[-0.055em] tabular-nums">
          {phone.lockTime}
        </p>
      </div>
    )
  }

  <ol
    class:list={[
      'absolute inset-x-3 z-[1] flex flex-col gap-1.5 overflow-hidden',
      embedded
        ? 'top-[4.7rem] bottom-4 justify-start'
        : 'top-[7.9rem] bottom-[4.65rem] justify-end',
    ]}
    aria-label={`${phone.appName} notifications`}
  >
    {
      phone.notifications.map((note, index) => (
        <li
          class:list={[
            'rounded-[1.05rem] border px-2.5 py-1.5 shadow-md shadow-black/20 backdrop-blur-xl',
            index === 0
              ? 'border-white/15 bg-white/[0.14]'
              : 'border-white/10 bg-white/[0.09]',
          ]}
        >
          <div class="flex items-start gap-2">
            <img
              src={origin89Badge.src}
              alt=""
              class="mt-0.5 h-5 w-5 shrink-0 rounded-[0.42rem] shadow-sm shadow-black/30"
            />
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5 text-[0.46rem] leading-none text-white/50">
                <span class="font-display text-[0.38rem] tracking-[0.05em] uppercase">
                  {phone.appName}
                </span>
                <span class="ml-auto shrink-0">{note.when}</span>
              </div>
              <p class="mt-1 text-[0.66rem] leading-none font-semibold text-white">
                {note.title}
              </p>
              <p class="mt-0.5 text-[0.58rem] leading-[1.2] text-white/68">{note.body}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  {
    !embedded && (
      <div aria-hidden="true" class="absolute inset-x-5 bottom-4 z-[1] flex items-center justify-between">
        <span class="grid h-9 w-9 place-items-center rounded-full border border-white/10 bg-black/30 text-white/85 backdrop-blur-xl">
          <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current">
            <path d="M8.6 2.5h6.8l-1 5.1h-4.8l-1-5.1Zm.8 6.8h5.2l1 2.7-2.1 9.5h-3L8.4 12l1-2.7Z" />
          </svg>
        </span>
        <span class="grid h-9 w-9 place-items-center rounded-full border border-white/10 bg-black/30 text-white/85 backdrop-blur-xl">
          <svg viewBox="0 0 24 24" class="h-[1.05rem] w-[1.05rem] fill-none stroke-current" stroke-width="1.8">
            <path d="M7.5 7.5 9 5.5h6l1.5 2H19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.5Z" />
            <circle cx="12" cy="13.2" r="3.7" />
          </svg>
        </span>
      </div>
    )
  }
</div>
