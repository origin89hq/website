---
import { directions } from "../../../lib/concepts";
export function getStaticPaths() {
  return directions.map((direction) => ({
    params: { direction: direction.id },
    props: { direction },
  }));
}
const { direction } = Astro.props;
---
<Shell title={`${direction.title} / Offgrid app`} direction={direction.id}>
<main id="main" class="standalone-app"><BuddyApp theme={direction.id} scene={direction.scene} id={`standalone-${direction.id}`}/><div class="app-review-note"><strong>Origin89 Offgrid + Buddy</strong><span>Interactive concept · Sample data</span><a href="/concepts/" target="_top">Compare website & app directions ↗</a></div></main>
</Shell>
