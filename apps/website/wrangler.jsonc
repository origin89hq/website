{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "origin89-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  // Buddy owns the inference, the knowledge database and the session state, and
  // has no route of its own. This binding is the only way in, which is what
  // keeps every secret it needs out of the worker that faces the internet.
  // `deployment-config.mjs` rewrites the service name for the deployed pair.
  "services": [{ "binding": "BUDDY", "service": "origin89-buddy-poc" }],
  // The waitlist adds addresses to this Mailchimp audience. `deployment-config.mjs`
  // replaces the Turnstile hostnames with the production ones.
  "vars": {
    "MAILCHIMP_AUDIENCE_ID": "614c5bde81",
    "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1"
  },
  // The deploy uploads these with the version, and Wrangler refuses one without
  // them. Local development reads them from .dev.vars and only warns when missing.
  "secrets": { "required": ["MAILCHIMP_API_KEY", "TURNSTILE_SECRET_KEY"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Static files are served without running this worker at all; only the API
    // paths pay for an invocation.
    "run_worker_first": ["/api/buddy/*", "/api/waitlist"],
    // React routes are pre-rendered as directories with index.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // `wrangler dev --env fixture` renames the Buddy worker, so the binding has
  // to name the renamed one or it resolves to nothing and every API call is a
  // 503 that looks like Buddy is down rather than like a misconfigured pair.
  "env": {
    "fixture": {
      "services": [{ "binding": "BUDDY", "service": "origin89-buddy-poc-fixture" }],
      // Named environments do not inherit vars.
      "vars": {
        "MAILCHIMP_AUDIENCE_ID": "614c5bde81",
        "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1"
      }
    }
  }
}
