---
interface Props {
  text: string;
}

const { text } = Astro.props;
const _parts = text.split(/(Origin ?89)/g);
---

{
  parts.map((part) =>
    /^Origin ?89$/.test(part) ? (
      <span class="relative -top-px font-display text-[0.78em] font-normal tracking-[0.04em] whitespace-nowrap">
        Origin 89
      </span>
    ) : (
      part
    ),
  )
}
