---
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
---

<footer class="relative" data-footer>
  <div
    class="footer-runway relative h-[160svh] lg:h-[220svh]"
    data-footer-runway
  >
    <div
      class="footer-stage sticky top-0 flex h-svh items-center justify-center overflow-hidden"
      data-footer-stage
    >
      <ParallaxScene id="footer-night" mode="night" />

      <div
        class="pointer-events-none absolute bottom-7 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center gap-2 text-faint"
        aria-hidden="true"
        data-footer-scroll-cue
      >
        <span class="font-mono text-[0.62rem] tracking-[0.18em] uppercase">Scroll</span>
        <svg viewBox="0 0 64 38" class="h-auto w-7" fill="none">
          <path d="m8 7 24 24L56 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>

      <a
        href="#what-it-does"
        class="group relative top-[clamp(3rem,10svh,6.5rem)] z-10 flex flex-col items-center px-6 text-center"
        data-footer-back
      >
        <svg
          viewBox="0 0 64 38"
          class="h-auto w-14 text-fg/45 transition-colors group-hover:text-action-lit group-focus-visible:text-action-lit"
          fill="none"
          aria-hidden="true"
        >
          <path d="m8 31 24-24 24 24" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="headline mt-5 text-[clamp(2.8rem,8vw,6.5rem)] leading-none tracking-[-0.05em] text-fg/55 transition-colors group-hover:text-fg group-focus-visible:text-fg">
          {copy.footer.back}
        </span>
        <span class="mt-5 font-mono text-[0.64rem] tracking-[0.16em] text-faint/70 uppercase transition-colors group-hover:text-muted group-focus-visible:text-muted">
          {copy.footer.backNote}
        </span>
      </a>

      <div
        class="footer-meta pointer-events-none absolute inset-x-0 bottom-0 z-20"
        data-footer-meta
      >
        <div
          class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6 pb-7 text-center sm:pb-9 lg:flex-row lg:items-end lg:justify-between lg:text-left"
        >
          <div class="pointer-events-auto max-w-sm">
            <div class="flex items-center justify-center gap-2.5 lg:justify-start">
              <LogoBadge size="sm" />
              <Wordmark class="text-sm" />
            </div>
            <p class="mt-3 text-sm text-muted">{copy.footer.tagline}</p>
            <p class="mt-4 font-mono text-xs text-faint">{copy.footer.licence}</p>
          </div>

          <div class="pointer-events-auto flex items-center gap-5 text-sm text-muted">
            <a href={SITE.docsUrl} class="transition-colors hover:text-fg">
              {copy.nav.docs}<span aria-hidden="true"> ↗</span>
            </a>
            <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-fg">
              {SITE.email}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-stage {
    background: var(--color-content-sky);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-runway {
      height: auto;
    }

    .footer-stage {
      position: relative;
      min-height: 100svh;
    }

    [data-footer-scroll-cue] {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const footer = document.querySelector<HTMLElement>('[data-footer]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const compact = window.matchMedia('(max-width: 1023px)').matches;

  if (footer && !still) {
    const runway = footer.querySelector<HTMLElement>('[data-footer-runway]');
    const back = footer.querySelector<HTMLElement>('[data-footer-back]');
    const meta = footer.querySelector<HTMLElement>('[data-footer-meta]');
    const scrollCue = footer.querySelector<HTMLElement>('[data-footer-scroll-cue]');
    const scene = footer.querySelector<HTMLElement>("[data-parallax-scene='footer-night']");
    const artwork = scene?.querySelector<HTMLObjectElement>('[data-scene-artwork]');
    let lastSceneProgress = 0;
    let bindAttempts = 0;
    let sceneNodes: {
      scene3: SVGElement | null;
      nightBackdrop: SVGElement | null;
      nightGradient: SVGElement | null;
      stars: SVGElement | null;
      hills: (SVGElement | null)[];
    } | null = null;

    const bindNightScene = () => {
      const document = artwork?.contentDocument;
      if (!document?.documentElement) return null;
      const byId = (id: string) => document.getElementById(id) as SVGElement | null;

      sceneNodes = {
        scene3: byId('scene3'),
        nightBackdrop: byId('bg2'),
        nightGradient: byId('bg2-grad'),
        stars: byId('stars'),
        hills: [1, 2, 3, 4, 5].map((index) => byId(`h3-${index}`)),
      };
      return sceneNodes;
    };

    if (back) gsap.set(back, { y: 110, autoAlpha: 0 });
    if (meta) gsap.set(meta, { y: 28, autoAlpha: 0 });
    if (scrollCue) gsap.set(scrollCue, { y: 8, autoAlpha: 0 });

    const renderNightScene = (progress: number) => {
      if (!artwork) return;
      const rawProgress = Math.max(0, Math.min(1, progress));
      const p = compact ? 0.18 + rawProgress * 0.82 : rawProgress;
      const smoothStep = (start: number, end: number) => {
        const raw = Math.max(0, Math.min(1, (p - start) / (end - start)));
        return raw * raw * (3 - 2 * raw);
      };
      const sky = smoothStep(0.04, compact ? 0.3 : 0.42);
      const backdrop = smoothStep(compact ? 0.32 : 0.55, compact ? 0.72 : 0.92);
      const rise = smoothStep(compact ? 0.08 : 0.18, compact ? 0.68 : 0.9);
      const reveal = smoothStep(compact ? 0.48 : 0.5, compact ? 0.78 : 0.8);
      const metaReveal = smoothStep(compact ? 0.7 : 0.68, compact ? 0.94 : 0.92);
      const cueIn = smoothStep(compact ? 0.18 : 0.28, compact ? 0.3 : 0.42);
      const cueOut = 1 - smoothStep(compact ? 0.44 : 0.52, compact ? 0.56 : 0.64);
      const cueOpacity = Math.min(cueIn, cueOut);
      lastSceneProgress = rawProgress;
      if (scrollCue) {
        gsap.set(scrollCue, {
          y: 8 * (1 - cueIn) - 8 * (1 - cueOut),
          autoAlpha: cueOpacity,
        });
      }
      const art = sceneNodes ?? bindNightScene();
      if (!art) return;

      gsap.set(artwork, {
        y: 18 - p * 30,
        scale: 1.06 - p * 0.025,
        transformOrigin: '50% 68%',
      });
      // Stars and mountains can begin moving as the footer enters, but keep the
      // SVG's full-frame purple backdrop transparent until the footer is nearly
      // established. That makes its first visible row exactly the same solid
      // color as the content above instead of drawing a horizontal seam.
      gsap.set(art.scene3, { y: 0, opacity: 1 });
      gsap.set(art.nightBackdrop, { opacity: backdrop * backdrop });
      if (art.nightGradient) {
        art.nightGradient.setAttribute('cy', String(500 + backdrop * 100));
        art.nightGradient.setAttribute('r', String(632 - backdrop * 132));
      }
      gsap.set(art.stars, {
        y: 120 * (1 - sky) - 90 * rise,
        opacity: sky * 0.68,
      });
      const starts = compact ? [180, 420, 320, 460, 520] : [300, 800, 600, 800, 1000];
      const settles = [-6, -12, -18, -24, -30];
      art.hills.forEach((hill, index) => {
        if (!hill) return;
        gsap.set(hill, {
          x: (index % 2 === 0 ? -1 : 1) * 10 * rise,
          y:
            (starts[index] ?? 600) * (1 - rise) +
            (settles[index] ?? -18) * rise,
        });
      });
      if (back) {
        gsap.set(back, {
          y: 110 * (1 - reveal),
          scale: 0.97 + reveal * 0.03,
          autoAlpha: reveal,
        });
      }
      if (meta) {
        gsap.set(meta, {
          y: 28 * (1 - metaReveal),
          autoAlpha: metaReveal,
        });
      }
    };

    const syncNightScene = () => {
      sceneNodes = null;
      if (!bindNightScene()) {
        if (bindAttempts++ < 60) requestAnimationFrame(syncNightScene);
        return;
      }
      bindAttempts = 0;
      renderNightScene(lastSceneProgress);
    };

    scene?.addEventListener('o89:artwork-ready', syncNightScene);
    artwork?.addEventListener('load', syncNightScene);
    if (scene?.classList.contains('is-loaded')) syncNightScene();

    if (runway) {
      ScrollTrigger.create({
        trigger: runway,
        start: 'top bottom',
        end: 'bottom bottom',
        scrub: 1.35,
        invalidateOnRefresh: true,
        onUpdate: (self) => renderNightScene(self.progress),
      });
    }
    renderNightScene(0);

  }
</script>
