---
import { directions } from "../../lib/concepts";
export function getStaticPaths() {
  return directions.map((direction) => ({
    params: { direction: direction.id },
    props: { direction },
  }));
}
const { direction } = Astro.props;
---
<Shell title={direction.title} direction={direction.id}><Website direction={direction.id}/></Shell>
