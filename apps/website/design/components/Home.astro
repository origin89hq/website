---
import { type Direction, href } from "../lib/content";

interface Props {
  direction: Direction;
}
const { direction } = Astro.props;
const _url = (page = "") => href(direction, page);
---
{direction === 'field-guide' ? <section class="home-hero wrap">
  <div class="hero-copy"><span class="eyebrow"><span class="tiny-plate" aria-hidden="true"></span> Simple control. Your way.</span><h1>Your corner.<br /><em>Your control.</em></h1><p>Your power, your equipment, your way of doing things. Bring it together with Origin89.</p><div class="actions"><a class="button" href={url('products')}>Meet the product family <span aria-hidden="true">↗</span></a><a class="text-link" href={url('solutions')}>Find your site <span aria-hidden="true">↗</span></a></div><div class="hero-footnote"><span>Designed for local control.</span><span>From the cottage to the field.</span></div></div>
  <div class="hero-stage"><svg class="contours" viewBox="0 0 700 800" fill="none" aria-hidden="true"><g stroke="currentColor">{[0,1,2,3,4,5,6,7,8].map(i => <ellipse cx="470" cy="360" rx={190+i*34} ry={260+i*34} transform="rotate(27 470 360)" />)}</g></svg><div class="stage-marker"><span>ORIGIN89 OFFGRID</span><span>01 / SITE OVERVIEW</span></div><Dashboard /><div class="stage-bottom"><span>A place for every reading.</span><span>Designed around you. ↗</span></div></div>
</section> : <section class="instrument-hero wrap"><div class="hero-copy"><span class="eyebrow">Origin89 / Site control system</span><h1>At your site.<br /><em>In your hands.</em></h1><p>Local control, a clear view of your equipment, and help when you need it.</p><div class="actions"><a class="button" href={url('products')}>Explore the system <span aria-hidden="true">↗</span></a><a class="text-link" href={url('products/controller')}>Inside the Controller ↗</a></div><div class="instrument-readout"><span>01 / CONTROLLER</span><span>02 / OFFGRID</span><span>03 / BUDDY</span></div></div><div class="hardware-stage"><span class="stage-marker">ORIGIN89 CONTROLLER / CAD STUDY</span><img src={art.controller} alt="Origin89 Controller CAD render; earlier enclosure artwork" /><span class="hardware-caption">Control at the site.<br />Built around real equipment.</span></div></section>}
<div class="promise-strip"><div class="wrap"><span>Hardware at your site.</span><span>A view that’s yours.</span><span>Help beside the task.</span></div></div>
<section class="section wrap"><div class="section-heading"><div><span class="eyebrow">01 / A connected product family</span><h2>Three parts.<br />One clearer picture.</h2></div><p>Controller connects to the equipment. Offgrid puts your site in view. Buddy helps you understand the next step.</p></div><ProductCards direction={direction} /><div class="section-bottom"><span>One family, with a clear job for each part.</span><a class="text-link" href={url('products')}>See how they fit together ↗</a></div></section>
<section class="place-section"><img class="forest" src={art.forest} alt="A spruce forest in soft light" loading="lazy" /><div class="wrap place-content"><span class="eyebrow">02 / Built around your place</span><h2>Every site<br />has a story.</h2><p>A cabin at the end of the road. A sugarbush in full season. A pump that is a long drive away.</p><a href={url('solutions')} class="button pale">Find your starting point ↗</a><div class="place-links">{solutions.map(s => <a href={url(`solutions/${s.slug}`)}><span>{s.number}</span>{s.name}<span aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="section wrap feature-split"><div><span class="eyebrow">03 / Built for the gear already there</span><h2>Different equipment.<br /><em>Common ground.</em></h2><p>Solar, batteries, heaters, pumps, valves and field sensors. Start with the equipment you depend on, then build a clearer view around it.</p><a class="text-link" href={url('compatibility')}>Explore compatibility ↗</a></div><div class="interface-list">{[['RS-485 / Modbus', 'Meters, controllers & field equipment'], ['CAN / VE.Direct', 'Battery and power equipment'], ['Sensors & contacts', 'Temperature, levels & equipment state']].map(([name,body], i) => <div><span class="eyebrow">0{i+1}</span><div><h3>{name}</h3><p>{body}</p></div><span aria-hidden="true">↗</span></div>)}<p class="note">Compatibility is reviewed for the exact model and intended task.</p></div></section>
<section class="buddy-band wrap"><div class="buddy-band-art"><img src={art.buddy} alt="Buddy explaining a next step" loading="lazy" /></div><div><span class="eyebrow">Meet Buddy</span><h2>A familiar face.<br />A useful next step.</h2><p>Help with a reading. A check to work through. Buddy belongs beside the task, with the decision in your hands.</p><a class="text-link" href={url('products/buddy')}>Get to know Buddy ↗</a></div></section>
<Callout direction={direction} />
